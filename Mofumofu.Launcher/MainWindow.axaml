<suki:SukiWindow xmlns="https://github.com/avaloniaui"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Mofumofu.Launcher.Controls"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
                  xmlns:views="clr-namespace:Mofumofu.Launcher.Views"
                  mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="820"
                  x:Class="Mofumofu.Launcher.MainWindow"
                  Title="Mofumofu Launcher"
                  Width="1280" Height="820"
                  MinWidth="980" MinHeight="640"
                  WindowStartupLocation="CenterScreen"
                  IsTitleBarVisible="False"
                  BackgroundStyle="Flat"
                  RootCornerRadius="12"
                  CanFullScreen="False">

    <suki:SukiWindow.Hosts>
        <Grid>
            <suki:SukiDialogHost x:Name="DialogHost" />
            <StackPanel x:Name="ToastStack"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Left"
                        Margin="24,0,0,84"
                        Spacing="8"
                        IsHitTestVisible="False" />
        </Grid>
    </suki:SukiWindow.Hosts>

    <Panel x:Name="RootPanel" Background="{DynamicResource NekoSurfaceBrush}" ClipToBounds="True">
        <!-- 主窗口内部壁纸层：供 AcrylicSurface 采样做毛玻璃 -->
        <views:InAppWallpaperSurface x:Name="InAppWallpaper" IsVisible="False" />
        <!-- 插件接管壁纸层：IWallpaperEdit.WallpaperTakeOver 的挂载点 -->
        <Border x:Name="PluginWallpaperLayer" IsVisible="False" />
        <Border x:Name="BackdropLayer" Background="{StaticResource NekoBackgroundBrush}" />
        <Border x:Name="HeroGlowLayer" Background="{StaticResource NekoHeroGlowBrush}" IsHitTestVisible="False" />
        <Border x:Name="WallpaperDimLayer" Background="#000000" IsHitTestVisible="False" IsVisible="False" />

        <Grid RowDefinitions="40,*">
    <!-- ================= 自绘标题栏 ================= -->
            <Border x:Name="TitleBar"
                    Grid.Row="0"
                    Background="{DynamicResource NekoTitleBarBrush}"
                    BorderBrush="{DynamicResource NekoBorderBrush}"
                    BorderThickness="0,0,0,1"
                    PointerPressed="OnShellTitleBarPressed"
                    DoubleTapped="OnShellTitleBarDoubleTap">
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="14,0,8,0">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Image Source="avares://Mofumofu.Launcher/Assets/favicon.ico" Width="18" Height="18" />
                        <TextBlock Text="Mofumofu Launcher" FontSize="13.5" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Foreground="{DynamicResource NekoTextBrush}" />
                        <Border x:Name="BetaBadge" Classes="beta-badge" IsVisible="False"
                                VerticalAlignment="Center">
                            <TextBlock Text="BETA" FontSize="10" FontWeight="Bold" LetterSpacing="1" />
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2"
                                VerticalAlignment="Center">
                        <Button Classes="icon" Width="34" Height="30" ToolTip.Tip="{DynamicResource L.Shell.TitleBar.Minimize}"
                                Click="OnMinimizeClick">
                            <controls:IconParkIcon Kind="IconMinimize" Width="12" Height="12" />
                        </Button>
                        <Button x:Name="MaximizeButton" Classes="icon" Width="34" Height="30"
                                ToolTip.Tip="{DynamicResource L.Shell.TitleBar.Maximize}" Click="OnMaximizeClick">
                            <controls:IconParkIcon x:Name="MaximizeIcon" Kind="IconMaximize"
                                      Width="12" Height="12" />
                        </Button>
                        <Button Classes="icon" Width="34" Height="30" ToolTip.Tip="{DynamicResource L.Shell.TitleBar.Close}"
                                Click="OnCloseClick">
                            <controls:IconParkIcon Kind="IconClose" Width="12" Height="12" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= 内容区 ================= -->
            <Grid Grid.Row="1">
                <Grid RowDefinitions="*,Auto">
                    <ContentControl x:Name="PageHost" Grid.Row="0" Margin="20,16,20,12" />

                    <!-- 底部开始栏 -->
                    <Border x:Name="StartBar"
                            Grid.Row="1"
                            Height="58"
                            Background="{DynamicResource NekoStartBarBrush}"
                            BorderBrush="{DynamicResource NekoBorderBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="12,0">
                        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                <Button x:Name="StartButton" Classes="nav" ToolTip.Tip="{DynamicResource L.Shell.StartBar.Start}"
                                        Click="OnStartButtonClick">
                                    <controls:IconParkIcon Kind="IconGrid" Width="18" Height="18" />
                                </Button>
                                <Border Width="1" Height="24" Margin="8,0"
                                        Background="{StaticResource NekoBorderBrush}" />
                                <StackPanel x:Name="TaskbarNavPanel" Orientation="Horizontal"
                                            Spacing="3" VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                        VerticalAlignment="Center">
                                <StackPanel x:Name="PluginTrayPanel" Orientation="Horizontal"
                                            Spacing="3" VerticalAlignment="Center" />
                                <ComboBox x:Name="VersionCombo" Classes="startbar" Height="36" MinWidth="176"
                                          PlaceholderText="{DynamicResource L.Shell.StartBar.NoVersion}"
                                          SelectionChanged="OnVersionSelectionChanged"
                                          ToolTip.Tip="{DynamicResource L.Shell.StartBar.VersionTip}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                                <Image Source="{Binding Icon}" Width="18" Height="18" />
                                                <TextBlock Text="{Binding DisplayName}" FontSize="12"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <ComboBox x:Name="AccountCombo" Classes="startbar" Height="36" MinWidth="152"
                                          PlaceholderText="{DynamicResource L.Shell.StartBar.NoAccount}"
                                          SelectionChanged="OnAccountSelectionChanged"
                                          ToolTip.Tip="{DynamicResource L.Shell.StartBar.AccountTip}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                                <Panel Width="24" Height="24">
                                                    <Border x:Name="HeadFallback" CornerRadius="6"
                                                            Background="{DynamicResource NekoAccentSoftBrush}"
                                                            IsVisible="{Binding !HasHead}">
                                                        <controls:IconParkIcon Kind="IconAccount" Width="14" Height="14" />
                                                    </Border>
                                                    <Border CornerRadius="6" ClipToBounds="True" IsVisible="{Binding HasHead}">
                                                        <Image Source="{Binding Head}" Width="24" Height="24"
                                                               Stretch="UniformToFill" />
                                                    </Border>
                                                </Panel>
                                                <TextBlock Text="{Binding DisplayName}" FontSize="12"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button x:Name="LogButton" Classes="ghost" Height="38" Width="38"
                                        Padding="0" Click="OnOpenLaunchLogClick"
                                        ToolTip.Tip="{DynamicResource L.Shell.StartBar.LogTip}">
                                    <controls:IconParkIcon Kind="IconFluentCode" Width="16" Height="16" />
                                </Button>
                                <Button x:Name="LaunchButton" Classes="primary" Height="38" Padding="18,0"
                                        Click="OnLaunchButtonClick">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <controls:IconParkIcon x:Name="LaunchIcon" Kind="IconPlay"
                                                  Width="14" Height="14" />
                                        <TextBlock x:Name="LaunchText" Text="{DynamicResource L.Shell.StartBar.Launch}" FontSize="13"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ================= 开始菜单 ================= -->
                <Grid x:Name="StartMenuOverlay" IsVisible="False" Background="Transparent"
                      PointerPressed="OnStartMenuOverlayPointerPressed">
                    <Border x:Name="StartMenuCard"
                            Width="360"
                            Height="600"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Margin="16,0,0,70"
                            RenderTransformOrigin="0,1"
                            Background="{DynamicResource NekoDialogBrush}"
                            BorderBrush="{StaticResource NekoBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                        <Grid RowDefinitions="Auto,*,Auto">
                            <Grid Grid.Row="0" Margin="18,14,18,6">
                                <TextBlock Text="{DynamicResource L.Shell.StartMenu.Title}" Classes="section-title" />
                            </Grid>
                            <ScrollViewer Grid.Row="1" Margin="10,0,10,8"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="StartMenuPanel" Spacing="2" />
                            </ScrollViewer>

                        </Grid>
                    </Border>
                </Grid>

            </Grid>
        </Grid>

        <!-- ================= 无边框窗口缩放热区（覆盖整窗，最后绘制） ================= -->
        <Grid Grid.RowSpan="2">
            <Border VerticalAlignment="Top" Height="5" Background="Transparent"
                    Cursor="SizeNorthSouth" PointerPressed="OnResizeTop" />
            <Border VerticalAlignment="Bottom" Height="5" Background="Transparent"
                    Cursor="SizeNorthSouth" PointerPressed="OnResizeBottom" />
            <Border HorizontalAlignment="Left" Width="5" Background="Transparent"
                    Cursor="SizeWestEast" PointerPressed="OnResizeLeft" />
            <Border HorizontalAlignment="Right" Width="5" Background="Transparent"
                    Cursor="SizeWestEast" PointerPressed="OnResizeRight" />
            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Width="9" Height="9"
                    Background="Transparent" Cursor="TopLeftCorner" PointerPressed="OnResizeTopLeft" />
            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Width="9" Height="9"
                    Background="Transparent" Cursor="TopRightCorner" PointerPressed="OnResizeTopRight" />
            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="9" Height="9"
                    Background="Transparent" Cursor="BottomLeftCorner" PointerPressed="OnResizeBottomLeft" />
            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="9" Height="9"
                    Background="Transparent" Cursor="BottomRightCorner" PointerPressed="OnResizeBottomRight" />
        </Grid>
    </Panel>
</suki:SukiWindow>
