<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Mofumofu.Launcher.Controls"
             x:Class="Mofumofu.Launcher.Controls.PageHeader">
    
    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10">
        <Button x:Name="BackButton"
                Classes="round"
                Width="32" Height="32"
                CornerRadius="16"
                Margin="0,0,10,0"
                Click="OnBackClick">
            <controls:IconParkIcon Kind="IconArrowLeft" Width="16" Height="16" />
        </Button>

        <ContentControl x:Name="ActionsHost"
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center" />
    </Grid>
</UserControl>
