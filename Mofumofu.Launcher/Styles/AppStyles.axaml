        <!-- ==== 字体 ==== -->
        <FontFamily x:Key="NekoIconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    </Styles.Resources>

    <!-- 弹窗（SukiDialog）用不透明底板：默认玻璃材质在内容留白多时会透出下层页面 -->
    <Style Selector="suki|SukiDialog">
        <Setter Property="Background" Value="{DynamicResource NekoDialogSolidBrush}" />
    </Style>
    <!-- SukiDialogHost 遮罩走 NekoScrimBrush：浅色压白，深色压黑 -->
    <Style Selector="suki|SukiDialogHost /template/ Border#PART_DialogBackground">
        <Setter Property="Background" Value="{DynamicResource NekoScrimBrush}" />
    </Style>
    <!-- ================= 交互反馈（统一去掉点击黑框） ================= -->
    <!-- 焦点框默认值：不画焦点虚线框 -->
    <Style Selector="AdornerLayer">
        <Setter Property="DefaultFocusAdorner" Value="{x:Null}" />
    </Style>
    <Style Selector=":is(Control)">
        <Setter Property="FocusAdorner" Value="{x:Null}" />
    </Style>
    <Style Selector=":is(Control):focus">
        <Setter Property="FocusAdorner" Value="{x:Null}" />
    </Style>
    <Style Selector=":is(Control):focus-visible">
        <Setter Property="FocusAdorner" Value="{x:Null}" />
    </Style>
    <Style Selector="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="RenderTransform" Value="none" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.08" />
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
                <BrushTransition Property="Background" Duration="0:0:0.12" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button:pointerover">
        <Setter Property="RenderTransform" Value="scale(1.015)" />
    </Style>
    <Style Selector="Button:pressed">
        <Setter Property="Opacity" Value="0.86" />
        <Setter Property="RenderTransform" Value="scale(0.985)" />
    </Style>
    <!-- 默认按钮按下：不要黑块，用轻微提亮的同色系 -->
    <Style Selector="Button:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource NekoPressBrush}" />
    </Style>

    <!-- ================= 文本 ================= -->
    <Style Selector="TextBlock.page-title">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource NekoTextBrush}" />
    </Style>
    <Style Selector="TextBlock.section-title">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource NekoTextBrush}" />
    </Style>
    <Style Selector="TextBlock.muted">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource NekoMutedBrush}" />
    </Style>
    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource NekoDimBrush}" />
    </Style>
    <Style Selector="TextBlock.stat">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource NekoTextBrush}" />
    </Style>

    <!-- ================= 表面 ================= -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{StaticResource NekoCardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource NekoBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="18" />
    </Style>
    <Style Selector="Border.card-soft">
        <Setter Property="Background" Value="{StaticResource NekoCardSoftBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource NekoBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14" />
    </Style>
    <Style Selector="Border.divider">
        <Setter Property="Background" Value="{StaticResource NekoBorderBrush}" />
        <Setter Property="Height" Value="1" />
    </Style>

    <!-- ================= 按钮 ================= -->
    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{StaticResource NekoAccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource NekoAccentOnBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16,8" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource NekoAccentHoverBrush}" />
    </Style>
    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource NekoBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Foreground" Value="{StaticResource NekoTextBrush}" />
        <Setter Property="Padding" Value="14,7" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource NekoBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.icon">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.icon:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource NekoBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.nav">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource NekoNavIdleBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource NekoBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Button.nav.active">
        <Setter Property="Background" Value="{StaticResource NekoAccentSoftBrush}" />
        <Setter Property="Foreground" Value="{StaticResource NekoAccentBrush}" />
    </Style>
    <Style Selector="Button.nav.active:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource NekoAccentSoftBrush}" />
    </Style>
    <Style Selector="Button.pill">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="Foreground" Value="{DynamicResource NekoMutedBrush}" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.pill:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource NekoBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.pill.active">
        <Setter Property="Background" Value="{StaticResource NekoAccentSoftBrush}" />
        <Setter Property="Foreground" Value="{StaticResource NekoAccentBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Button.round">
        <Setter Property="Background" Value="{DynamicResource NekoFieldHoverBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="19" />
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource NekoTextBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.round:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource NekoBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.tile">
        <Setter Property="Background" Value="{DynamicResource NekoFieldSoftBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource NekoBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.tile:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource NekoBorderBrush}" />
    </Style>

    <Style Selector="Button.menu-row">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Height" Value="38" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.menu-row:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource NekoBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <!-- ================= 输入 / 列表 ================= -->
    <Style Selector="TextBox.search">
        <Setter Property="Background" Value="{DynamicResource NekoFieldSoftBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource NekoBorderBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,8" />
    </Style>
    <Style Selector="ListBoxItem">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="8" />
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
        <!-- 悬停 = 高亮描边框，不做整块填充 -->
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource NekoBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="ListBoxItem:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource NekoPressBrush}" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource NekoAccentSoftBrush}" />
    </Style>
    <Style Selector="ListBoxItem:selected:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource NekoAccentSoftBrush}" />
    </Style>

    <!-- 下拉项：同样悬停 = 描边框 -->
    <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource NekoBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="ComboBoxItem:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource NekoPressBrush}" />
    </Style>

    <!-- 开始栏里的紧凑选择器（版本 / 账号）：无外框感、悬停才显底色 -->
    <Style Selector="ComboBox.startbar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ComboBox.startbar /template/ Border#Background">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ComboBox.startbar:pointerover /template/ Border#Background">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource NekoBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="ComboBox.startbar:pressed /template/ Border#Background">
        <Setter Property="Background" Value="{DynamicResource NekoPressBrush}" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <!-- ================= 各按钮样式的按下态 ================= -->
    <Style Selector="Button.primary:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource NekoAccentPressedBrush}" />
    </Style>
    <Style Selector="Button.ghost:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource NekoPressBrush}" />
    </Style>
    <Style Selector="Button.icon:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource NekoPressBrush}" />
    </Style>
    <Style Selector="Button.nav:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource NekoPressBrush}" />
    </Style>
    <Style Selector="Button.nav.active:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource NekoAccentSoftHoverBrush}" />
    </Style>
    <Style Selector="Button.pill:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource NekoPressBrush}" />
    </Style>
    <Style Selector="Button.round:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource NekoControlPressedBrush}" />
    </Style>
    <Style Selector="Button.tile:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource NekoPressBrush}" />
    </Style>
    <Style Selector="Button.menu-row:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource NekoPressBrush}" />
    </Style>
    <Style Selector="Button.rail:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource NekoPressBrush}" />
    </Style>
    <Style Selector="Button.player:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource NekoPressBrush}" />
    </Style>

    <Style Selector="Image.icon-tile">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
    </Style>
    <Style Selector="PathIcon.tile-icon">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Foreground" Value="{StaticResource NekoAccentBrush}" />
    </Style>

    <!-- ================= 悬停统一：不要任何方块底色，只让图标/文字变青绿 ================= -->
    <Style Selector="Button:pointerover">
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource NekoAccentBrush}" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ToggleButton:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <!-- 选中态/强调色按钮保留原有背景，不出现悬停方块 -->
    <Style Selector="Button.primary:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource NekoAccentOnBrush}" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource NekoAccentHoverBrush}" />
    </Style>
    <Style Selector="Button.nav.active:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource NekoAccentSoftBrush}" />
    </Style>
    <Style Selector="Button.pill.active:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource NekoAccentSoftBrush}" />
    </Style>
    <Style Selector="Button.rail.active:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource NekoAccentSoftBrush}" />
    </Style>
    <!-- SukiUI Danger 语义按钮：把全局 hover 的透明背景覆盖回 Suki 语义色 -->
    <Style Selector="Button.Danger:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource SukiDangerForeground}" />
    </Style>
    <Style Selector="Button.Danger:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SukiDangerMediumColor}" />
    </Style>
    <Style Selector="Button.Danger:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SukiDangerDarkColor}" />
    </Style>

    <!-- BETA 徽章：标题栏版本阶段标记 -->
    <!-- 语言切换旗子卡片 -->
    <Style Selector="Button.language-card">
        <Setter Property="Background" Value="{DynamicResource NekoFieldBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NekoBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="9,5" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Foreground" Value="{DynamicResource NekoTextBrush}" />
    </Style>
    <Style Selector="Button.language-card:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource NekoFieldHoverBrush}" />
    </Style>
    <Style Selector="Button.language-card.active">
        <Setter Property="Background" Value="{DynamicResource NekoAccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NekoAccentBrush}" />
    </Style>

    <Style Selector="Border.beta-badge">
        <Setter Property="Background" Value="#E8B93A" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="6,2" />
    </Style>
    <Style Selector="Border.beta-badge TextBlock">
        <Setter Property="Foreground" Value="#1A1206" />
    </Style>
</Styles>
