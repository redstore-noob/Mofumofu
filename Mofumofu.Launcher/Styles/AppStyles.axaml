<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI">
    <Styles.Resources>
        <!-- ==== 主题令牌 ====
             这里是唯一允许出现颜色字面量的地方：初值是深色主题，实际取值由
             Services/ThemeManager 在换主题/换强调色时统一改写（就地改 brush 的 Color）。
             视图里一律用 {DynamicResource NekoXxxBrush}，不要写死颜色。 -->
        <SolidColorBrush x:Key="NekoAccentBrush" Color="#3B6EF6" />
        <SolidColorBrush x:Key="NekoAccentHoverBrush" Color="#5C8AFB" />
        <SolidColorBrush x:Key="NekoAccentPressedBrush" Color="#2A57D8" />
        <SolidColorBrush x:Key="NekoAccentSoftBrush" Color="#131F3D" />
        <SolidColorBrush x:Key="NekoAccentSoftHoverBrush" Color="#182954" />
        <SolidColorBrush x:Key="NekoAccentOnBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="NekoAccentLineBrush" Color="#254390" />

        <SolidColorBrush x:Key="NekoTextBrush" Color="#E9EEF6" />
        <SolidColorBrush x:Key="NekoMutedBrush" Color="#93A0B4" />
        <SolidColorBrush x:Key="NekoDimBrush" Color="#74839A" />
        <SolidColorBrush x:Key="NekoBorderBrush" Color="#26303D" />

        <SolidColorBrush x:Key="NekoDangerBrush" Color="#E5484D" />
        <SolidColorBrush x:Key="NekoDangerSoftBrush" Color="#3A1B1E" />
        <SolidColorBrush x:Key="NekoSuccessBrush" Color="#4CC38A" />
        <SolidColorBrush x:Key="NekoSuccessSoftBrush" Color="#17342A" />
        <SolidColorBrush x:Key="NekoWarningBrush" Color="#F2AE49" />
        <SolidColorBrush x:Key="NekoWarningSoftBrush" Color="#3A2E18" />
        <SolidColorBrush x:Key="NekoInfoBrush" Color="#5AA9E6" />
        <SolidColorBrush x:Key="NekoInfoSoftBrush" Color="#16293A" />

        <SolidColorBrush x:Key="NekoCardBrush" Color="#D9121822" />
        <SolidColorBrush x:Key="NekoCardSoftBrush" Color="#B30E141C" />
        <SolidColorBrush x:Key="NekoCardHoverBrush" Color="#1A2230" />
        <SolidColorBrush x:Key="NekoSurfaceBrush" Color="#0A0E15" />
        <SolidColorBrush x:Key="NekoFieldBrush" Color="#16202B" />
        <SolidColorBrush x:Key="NekoFieldSoftBrush" Color="#0F151E" />
        <SolidColorBrush x:Key="NekoFieldHoverBrush" Color="#1A2430" />
        <SolidColorBrush x:Key="NekoPressBrush" Color="#1C2836" />
        <SolidColorBrush x:Key="NekoControlHoverBrush" Color="#243343" />
        <SolidColorBrush x:Key="NekoControlPressedBrush" Color="#2A3B4C" />
        <SolidColorBrush x:Key="NekoNavIdleBrush" Color="#9AA9BC" />
        <SolidColorBrush x:Key="NekoStartBarBrush" Color="#E60D131B" />
        <SolidColorBrush x:Key="NekoTitleBarBrush" Color="#B30C121A" />
        <SolidColorBrush x:Key="NekoDrawerBrush" Color="#F50C121A" />
        <SolidColorBrush x:Key="NekoOverlayBrush" Color="#66101822" />
        <SolidColorBrush x:Key="NekoDialogBrush" Color="#F20C121A" />
        <SolidColorBrush x:Key="NekoDialogSolidBrush" Color="#121A24" />
        <SolidColorBrush x:Key="NekoScrimBrush" Color="#FF000000" />
        <!-- 壁纸遮罩：深色模式压黑、浅色模式压白，透明度由「背景遮罩」滑块控制 -->
        <SolidColorBrush x:Key="NekoBackdropDimBrush" Color="#FF000000" />
        <SolidColorBrush x:Key="NekoTerminalBrush" Color="#05090C" />
        <SolidColorBrush x:Key="NekoTerminalTextBrush" Color="#9FE8D5" />

        <LinearGradientBrush x:Key="NekoBackgroundBrush" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#FF0A0E15" Offset="0" />
            <GradientStop Color="#FF0C1520" Offset="0.55" />
            <GradientStop Color="#FF0A1018" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="NekoHeroGlowBrush" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#1F3B6EF6" Offset="0" />
            <GradientStop Color="#00121822" Offset="0.6" />
            <GradientStop Color="#000A0E15" Offset="1" />
        </LinearGradientBrush>

        <!-- ==== 图标几何（Material Icons, Apache 2.0） ==== -->
