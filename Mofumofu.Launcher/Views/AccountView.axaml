<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Mofumofu.Launcher.Controls"
             xmlns:skin="clr-namespace:Mofumofu.Launcher.Controls.SkinView3D"
             mc:Ignorable="d" d:DesignWidth="1240" d:DesignHeight="720"
             x:Class="Mofumofu.Launcher.Views.AccountView">
    
    <UserControl.Styles>
        
        <Style Selector="ComboBox#SkinAnimationCombo /template/ Popup#PART_Popup">
            <Setter Property="ShouldUseOverlayLayer" Value="True" />
        </Style>

        
        <Style Selector="#AccountList ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        
        <Style Selector="#AccountList ListBoxItem /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style Selector="#AccountList ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="#AccountList ListBoxItem:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="#AccountList ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="#AccountList ListBoxItem:selected:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Border.account-row">
            <Setter Property="Background" Value="{DynamicResource NekoFieldSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NekoBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.14" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.14" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="#AccountList ListBoxItem:pointerover Border.account-row">
            <Setter Property="Background" Value="{DynamicResource NekoFieldHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NekoAccentLineBrush}" />
        </Style>
        <Style Selector="#AccountList ListBoxItem:selected Border.account-row">
            <Setter Property="Background" Value="{DynamicResource NekoAccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NekoAccentBrush}" />
        </Style>
        
        <Style Selector="Border.selection-bar">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="#AccountList ListBoxItem:selected Border.selection-bar">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        
        <Style Selector="StackPanel.row-actions">
            <Setter Property="Opacity" Value="0.45" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.16" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="#AccountList ListBoxItem:pointerover StackPanel.row-actions">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="#AccountList ListBoxItem:selected StackPanel.row-actions">
            <Setter Property="Opacity" Value="1" />
        </Style>
        
        <Style Selector="Button.row-action">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource NekoMutedBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.row-action:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NekoFieldBrush}" />
        </Style>
        <Style Selector="Button.row-action.danger:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NekoDangerSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NekoDangerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        
        <Style Selector="Button.primary /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        
        <Style Selector="Border.account-panel">
            <Setter Property="Background" Value="{DynamicResource NekoCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NekoBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="10" />
        </Style>
        <Style Selector="Border.section-icon">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{DynamicResource NekoAccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NekoAccentLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.stage-card">
            <Setter Property="Background" Value="{DynamicResource NekoCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NekoBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
        </Style>
        <Style Selector="Border.stage-chip">
            <Setter Property="Background" Value="{DynamicResource NekoCardSolidBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NekoBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="9,6" />
        </Style>
        <Style Selector="ComboBox#SkinAnimationCombo">
            <Setter Property="Background" Value="{DynamicResource NekoCardSolidBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NekoBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        
        <Style Selector="Button.skin-tool">
            <Setter Property="Background" Value="{DynamicResource NekoFieldSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NekoBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Foreground" Value="{DynamicResource NekoTextBrush}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="Stretch"
                                          VerticalContentAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.skin-tool:pointerover">
            <Setter Property="Background" Value="{DynamicResource NekoAccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NekoAccentBrush}" />
        </Style>
        <Style Selector="Button.skin-tool:pressed">
            <Setter Property="Background" Value="{DynamicResource NekoPressBrush}" />
        </Style>

        
        <Style Selector="Border.option-card">
            <Setter Property="Background" Value="{DynamicResource NekoCardSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NekoBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style Selector="TextBlock.option-title">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource NekoTextBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">
        <controls:PageHeader Grid.Row="0">
            <controls:PageHeader.Actions>
                <Button Classes="primary" Height="38" CornerRadius="10" Padding="16,0"
                        Click="OnAddAccountClick">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <controls:IconParkIcon Kind="IconFluentPerson" Width="15" Height="15" />
                        <TextBlock Text="{DynamicResource L.Account.Add.Title}" FontSize="12.5"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </controls:PageHeader.Actions>
        </controls:PageHeader>

<!-- ================= 左栏：账号列表 ================= -->        <Grid Grid.Row="1" ColumnDefinitions="310,*,288">
            
            <Grid Grid.Column="0" Margin="0,0,12,0">
                <Border Classes="account-panel" VerticalAlignment="Stretch">
                    <Grid RowDefinitions="*">
                        <ListBox x:Name="AccountList"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 SelectionChanged="OnAccountSelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Border Classes="account-row">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                
                                                <Grid Width="42" Height="42" VerticalAlignment="Center">
                                                    <Border CornerRadius="11" Background="{Binding AvatarBrush}"
                                                            IsVisible="{Binding HasFallback}">
                                                        <TextBlock Text="{Binding Initial}"
                                                                   FontSize="17" FontWeight="Bold"
                                                                   Foreground="{Binding InitialBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>
                                                    <Border CornerRadius="11" ClipToBounds="True"
                                                            Background="{DynamicResource NekoFieldSoftBrush}"
                                                            IsVisible="{Binding HasHead}">
                                                        <Image Source="{Binding Head}" Width="42" Height="42"
                                                               Stretch="UniformToFill"
                                                               RenderOptions.BitmapInterpolationMode="None" />
                                                    </Border>
                                                    
                                                    <Border Width="11" Height="11" CornerRadius="6"
                                                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                            Margin="0,0,-2,-2"
                                                            Background="{Binding TypeBadgeFg}"
                                                            BorderBrush="{DynamicResource NekoCardSolidBrush}"
                                                            BorderThickness="2" />
                                                </Grid>

                                                <StackPanel Grid.Column="1" Margin="10,0,6,0"
                                                            Spacing="5" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="13"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <Border CornerRadius="6" Padding="6,2"
                                                                Background="{Binding TypeBadgeBg}">
                                                            <TextBlock Text="{Binding TypeLabel}" FontSize="10.5"
                                                                       Foreground="{Binding TypeBadgeFg}" />
                                                        </Border>
                                                        <Border CornerRadius="6" Padding="6,2"
                                                                Background="{DynamicResource NekoWarningSoftBrush}"
                                                                IsVisible="{Binding IsDefault}">
                                                            <StackPanel Orientation="Horizontal" Spacing="3">
                                                                <controls:IconParkIcon Kind="IconFluentStarFilled"
                                                                                      Width="10" Height="10" />
                                                                <TextBlock Text="{DynamicResource L.Account.List.DefaultBadge}"
                                                                           FontSize="10.5"
                                                                           Foreground="{DynamicResource NekoWarningBrush}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Classes="row-actions"
                                                            Orientation="Vertical" Spacing="2"
                                                            VerticalAlignment="Center">
                                                    <Button Classes="row-action"
                                                            ToolTip.Tip="{DynamicResource L.Account.List.SetDefault}"
                                                            IsVisible="{Binding IsNotDefault}"
                                                            Click="OnSetDefaultClick">
                                                        <controls:IconParkIcon Kind="IconFluentStar"
                                                                               Width="13" Height="13" />
                                                    </Button>
                                                    <Button Classes="row-action danger"
                                                            ToolTip.Tip="{DynamicResource L.Common.Delete}"
                                                            Click="OnDeleteAccountClick">
                                                        <controls:IconParkIcon Kind="IconFluentDismiss"
                                                                               Width="13" Height="13" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        
                                        <Border Classes="selection-bar"
                                                Width="3" Height="28" CornerRadius="2"
                                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                                Margin="3,0,0,0" IsHitTestVisible="False"
                                                Background="{DynamicResource NekoAccentBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>

            
            <Border Grid.Column="1" Classes="stage-card" Margin="0,0,12,0">
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="16,14,16,10">
                        <TextBlock Text="{DynamicResource L.Account.Skin.Title}"
                                   Classes="section-title" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Classes="stage-chip" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <controls:IconParkIcon Kind="IconFluentCube" Width="12" Height="12" />
                                <TextBlock Text="3D" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource NekoMutedBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>
<!-- ================= 右栏：皮肤展示 + 玩家外观 ================= -->
                    
                    <Border Grid.Row="1" Margin="16,0,16,16" CornerRadius="14" ClipToBounds="True"
                            Background="{DynamicResource NekoFieldSoftBrush}"
                            BorderBrush="{DynamicResource NekoBorderBrush}" BorderThickness="1">
                        <Grid>
                            <skin:SkinView3D x:Name="NativeSkinViewer"
                                             Animation="Idle"
                                             Background="Transparent" />
                            
                            <Grid IsHitTestVisible="False">
                                <Border Background="{DynamicResource NekoHeroGlowBrush}"
                                        Opacity="0.45" />
                                <Border Height="1" Margin="48,0,48,52"
                                        VerticalAlignment="Bottom"
                                        Background="{DynamicResource NekoBorderBrush}"
                                        Opacity="0.7" />
                                <Border Width="3" Height="3" CornerRadius="2"
                                        HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Margin="18,18,0,0"
                                        Background="{DynamicResource NekoAccentLineBrush}" />
                                <Border Width="3" Height="3" CornerRadius="2"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Margin="0,18,18,0"
                                        Background="{DynamicResource NekoAccentLineBrush}" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="12" Margin="0,0,0,6">
                    <Border Classes="card" CornerRadius="18" Padding="12">
                        <StackPanel Spacing="7">
                            <Button Classes="skin-tool" ToolTip.Tip="{DynamicResource L.Account.Skin.Refresh}"
                                    Click="OnRefreshSkinClick">
                                <Grid ColumnDefinitions="Auto,*">
                                    <controls:IconParkIcon Kind="IconFluentArrowClockwise" Width="15" Height="15"
                                                           VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                               FontSize="12" TextTrimming="CharacterEllipsis"
                                               Text="{DynamicResource L.Account.Skin.Refresh}" />
                                </Grid>
                            </Button>
                            <Button Classes="skin-tool" ToolTip.Tip="{DynamicResource L.Account.Skin.Edit}"
                                    Click="OnEditSkinClick">
                                <Grid ColumnDefinitions="Auto,*">
                                    <controls:IconParkIcon Kind="IconFluentPaint" Width="15" Height="15"
                                                           VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                               FontSize="12" TextTrimming="CharacterEllipsis"
                                               Text="{DynamicResource L.Account.Skin.Edit}" />
                                </Grid>
                            </Button>
                            <Button Classes="skin-tool" ToolTip.Tip="{DynamicResource L.Account.Skin.Upload}"
                                    Click="OnUploadSkinClick">
                                <Grid ColumnDefinitions="Auto,*">
                                    <controls:IconParkIcon Kind="IconFluentGlobe" Width="15" Height="15"
                                                           VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                               FontSize="12" TextTrimming="CharacterEllipsis"
                                               Text="{DynamicResource L.Account.Skin.Upload}" />
                                </Grid>
                            </Button>
                            <Button Classes="skin-tool" ToolTip.Tip="{DynamicResource L.Account.Skin.Local}"
                                    Click="OnLocalSkinClick">
                                <Grid ColumnDefinitions="Auto,*">
                                    <controls:IconParkIcon Kind="IconFluentFolder" Width="15" Height="15"
                                                           VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                               FontSize="12" TextTrimming="CharacterEllipsis"
                                               Text="{DynamicResource L.Account.Skin.Local}" />
                                </Grid>
                            </Button>
                            <Button Classes="skin-tool" ToolTip.Tip="{DynamicResource L.Account.Skin.Library}"
                                    Click="OnSkinLibraryClick">
                                <Grid ColumnDefinitions="Auto,*">
                                    <controls:IconParkIcon Kind="IconFluentImage" Width="15" Height="15"
                                                           VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                               FontSize="12" TextTrimming="CharacterEllipsis"
                                               Text="{DynamicResource L.Account.Skin.Library}" />
                                </Grid>
                            </Button>

                            <Border Classes="divider" Margin="0,5" />

                            <StackPanel Spacing="6">
                                <TextBlock Text="{DynamicResource L.Account.Skin.Animation.Title}"
                                           Classes="caption" />
                                <ComboBox x:Name="SkinAnimationCombo" HorizontalAlignment="Stretch"
                                          SelectedIndex="1" SelectionChanged="OnSkinAnimationChanged">
                                    <ComboBoxItem Content="{DynamicResource L.Account.Skin.Animation.None}" Tag="{x:Static skin:SkinAnimation.None}" />
                                    <ComboBoxItem Content="{DynamicResource L.Account.Skin.Animation.Idle}" Tag="{x:Static skin:SkinAnimation.Idle}" />
                                    <ComboBoxItem Content="{DynamicResource L.Account.Skin.Animation.Walking}" Tag="{x:Static skin:SkinAnimation.Walking}" />
                                    <ComboBoxItem Content="{DynamicResource L.Account.Skin.Animation.Running}" Tag="{x:Static skin:SkinAnimation.Running}" />
                                    <ComboBoxItem Content="{DynamicResource L.Account.Skin.Animation.Flying}" Tag="{x:Static skin:SkinAnimation.Flying}" />
                                    <ComboBoxItem Content="{DynamicResource L.Account.Skin.Animation.Swimming}" Tag="{x:Static skin:SkinAnimation.Swimming}" />
                                    <ComboBoxItem Content="{DynamicResource L.Account.Skin.Animation.Crouching}" Tag="{x:Static skin:SkinAnimation.Crouching}" />
                                    <ComboBoxItem Content="{DynamicResource L.Account.Skin.Animation.Hitting}" Tag="{x:Static skin:SkinAnimation.Hitting}" />
                                    <ComboBoxItem Content="{DynamicResource L.Account.Skin.Animation.Waving}" Tag="{x:Static skin:SkinAnimation.Waving}" />
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Classes="card" CornerRadius="18" Padding="14,12">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <controls:IconParkIcon Kind="IconFluentWrench" Width="15" Height="15"
                                                       VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource L.Account.Appearance.Title}"
                                           Classes="section-title" VerticalAlignment="Center" />
                            </StackPanel>

                            <Border Classes="option-card">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{DynamicResource L.Account.Cape.Title}"
                                               Classes="option-title" />
                                    <ToggleSwitch x:Name="CapeSwitch" IsChecked="False"
                                                  OnContent="{DynamicResource L.Account.Cape.Show}"
                                                  OffContent="{DynamicResource L.Account.Cape.Hide}"
                                                  IsCheckedChanged="OnCapeToggled" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button Classes="ghost" Height="28" Padding="11,0" FontSize="11"
                                                CornerRadius="8" Click="OnEditCapeClick"
                                                Content="{DynamicResource L.Account.Cape.Edit}" />
                                        <Button x:Name="ResetCapeButton" Classes="ghost" Height="28"
                                                Padding="11,0" FontSize="11" CornerRadius="8"
                                                Click="OnResetCapeClick"
                                                Content="{DynamicResource L.Account.Cape.Reset}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Classes="option-card">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{DynamicResource L.Account.Model.Title}"
                                               Classes="option-title" />
                                    <ComboBox x:Name="SkinModelCombo" HorizontalAlignment="Stretch"
                                              SelectedIndex="0" SelectionChanged="OnSkinModelChanged">
                                        <ComboBoxItem Content="{DynamicResource L.Account.Model.Classic}" />
                                        <ComboBoxItem Content="{DynamicResource L.Account.Model.Slim}" />
                                    </ComboBox>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    
                </StackPanel>
            </ScrollViewer>
        </Grid>

<!-- 皮肤编辑器：内嵌到账户页（不再单独开窗口），布局与 3D 文字生成器一致 -->        
        <Grid x:Name="SkinEditorOverlay" Grid.RowSpan="2" IsVisible="False"
              Background="{DynamicResource NekoSurfaceBrush}" ClipToBounds="True">
            <Grid RowDefinitions="Auto,*">
                <Border Padding="16,12" BorderThickness="0,0,0,1"
                        Background="{DynamicResource NekoCardBrush}"
                        BorderBrush="{DynamicResource NekoBorderBrush}">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Button Classes="ghost" Height="36" CornerRadius="10" Padding="12,0"
                                Click="OnCloseSkinEditorClick">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <controls:IconParkIcon Kind="IconArrowLeft" Width="15" Height="15" />
                                <TextBlock Text="{DynamicResource L.Account.Skin.Editor.Back}" FontSize="12.5" />
                            </StackPanel>
                        </Button>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="1" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource L.Account.Skin.Editor.Title}"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource NekoTextBrush}" />
                        </StackPanel>
                        <Border Grid.Column="2" Classes="section-icon" VerticalAlignment="Center">
                            <controls:IconParkIcon Kind="IconFluentPaint" Width="16" Height="16"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>
                <Border x:Name="SkinEditorHost" Grid.Row="1"
                        Background="Transparent" ClipToBounds="True" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
