<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Mofumofu.Launcher.Controls"
             xmlns:edit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             mc:Ignorable="d" d:DesignWidth="1240" d:DesignHeight="720"
             x:Class="Mofumofu.Launcher.Views.ServersView"
             Background="Transparent">

    <UserControl.Styles>
        <Style Selector="Border.server-item">
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.16" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.server-item:pointerover">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource NekoBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.stat-sep">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="{DynamicResource NekoBorderBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Opacity" Value="0.6" />
        </Style>
        <Style Selector="Border.tile-icon">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{DynamicResource NekoFieldSoftBrush}" />
        </Style>
        <Style Selector="TextBlock.stat-value">
            <Setter Property="FontSize" Value="19" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource NekoTextBrush}" />
        </Style>
        <Style Selector="Button.tab-pill">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource NekoMutedBrush}" />
        </Style>
        <Style Selector="Button.tab-pill.active">
            <Setter Property="Background" Value="{DynamicResource NekoAccentSoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource NekoAccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.tab-pill.active /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NekoAccentSoftBrush}" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.tab-pill:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource NekoBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.tab-pill.active:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NekoAccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <controls:PageHeader Grid.Row="0">
            <controls:PageHeader.Actions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="ghost" Height="36" Padding="13,0" Click="OnImportClick">
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <controls:IconParkIcon Kind="IconFolder" Width="15" Height="15" />
                            <TextBlock Text="{DynamicResource L.Servers.Action.Import}" FontSize="12.5"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="ghost" Height="36" Padding="13,0" Click="OnRefreshClick">
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <controls:IconParkIcon Kind="IconRefresh" Width="15" Height="15" />
                            <TextBlock Text="{DynamicResource L.Servers.Action.Refresh}" FontSize="12.5"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="ghost" Height="36" Padding="13,0" Click="OnPairRemoteServerClick">
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <controls:IconParkIcon Kind="IconServer" Width="15" Height="15" />
                            <TextBlock Text="{DynamicResource L.Servers.Remote.AddRemote}" FontSize="12.5"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="primary" Height="36" Padding="14,0" Click="OnCreateServerClick">
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <controls:IconParkIcon Kind="IconPlus" Width="15" Height="15" />
                            <TextBlock Text="{DynamicResource L.Servers.Action.NewServer}" FontSize="12.5"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </controls:PageHeader.Actions>
        </controls:PageHeader>

        <Border x:Name="FallbackHint" Grid.Row="1" IsVisible="False"
                Classes="card-soft" Padding="12,8" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <controls:IconParkIcon Kind="IconFluentInfo" Width="15" Height="15"
                                       VerticalAlignment="Center" />
                <TextBlock Text="{DynamicResource L.Servers.Page.NoLocal}" FontSize="12"
                           Foreground="{DynamicResource NekoWarningBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Classes="card" Padding="16,12" Margin="0,0,0,12">
            <Grid ColumnDefinitions="*,Auto,*,Auto,*,Auto,*">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="9"
                            Background="{DynamicResource NekoSuccessSoftBrush}">
                        <controls:IconParkIcon Kind="IconPlay" Width="15" Height="15"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource L.Servers.Stat.Running}" Classes="caption" />
                        <TextBlock x:Name="RunningChipText" Text="0" Classes="stat-value" />
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Classes="stat-sep" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10"
                            Margin="16,0,0,0" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="9"
                            Background="{DynamicResource NekoAccentSoftBrush}">
                        <controls:IconParkIcon Kind="IconServer" Width="15" Height="15"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource L.Servers.Stat.Total}" Classes="caption" />
                        <TextBlock x:Name="TotalChipText" Text="0" Classes="stat-value" />
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="3" Classes="stat-sep" />
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="10"
                            Margin="16,0,0,0" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="9"
                            Background="{DynamicResource NekoFieldSoftBrush}">
                        <controls:IconParkIcon Kind="IconStop" Width="15" Height="15"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource L.Servers.Stat.Stopped}" Classes="caption" />
                        <TextBlock x:Name="StoppedChipText" Text="0" Classes="stat-value" />
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="5" Classes="stat-sep" />
                <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="10"
                            Margin="16,0,0,0" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="9"
                            Background="{DynamicResource NekoInfoSoftBrush}">
                        <controls:IconParkIcon Kind="IconAccount" Width="15" Height="15"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource L.Servers.Stat.Players}" Classes="caption" />
                        <TextBlock x:Name="PlayersChipText" Text="0" Classes="stat-value"
                                   Foreground="{DynamicResource NekoInfoBrush}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3" ColumnDefinitions="300,*">
            <Border Grid.Column="0" Classes="card" Padding="12">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{DynamicResource L.Servers.List.Title}"
                                   Classes="section-title" FontSize="13" VerticalAlignment="Center" />
                        <TextBlock x:Name="CountText" Grid.Column="1" Text="0 / 0" Classes="caption"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <TextBox x:Name="ServerSearch" Grid.Row="1" Height="34" Classes="search"
                             PlaceholderText="{DynamicResource L.Servers.Search.Placeholder}"
                             TextChanged="OnSearchChanged">
                        <TextBox.InnerLeftContent>
                            <controls:IconParkIcon Kind="IconSearch" Width="14" Height="14"
                                                   Margin="10,0,0,0" VerticalAlignment="Center" />
                        </TextBox.InnerLeftContent>
                    </TextBox>
                    <Grid Grid.Row="2">
                        <ListBox x:Name="ServerList" Background="Transparent" BorderThickness="0"
                                 Padding="0" SelectionChanged="OnServerSelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="server-item">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Border Width="40" Height="40" CornerRadius="10"
                                                    Background="{DynamicResource NekoFieldSoftBrush}">
                                                <Grid>
                                                    <controls:IconParkIcon Kind="IconFluentServer"
                                                                           Width="17" Height="17"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center" />
                                                    <Ellipse Width="9" Height="9" Fill="{Binding StatusFg}"
                                                             Stroke="{DynamicResource NekoCardSolidBrush}"
                                                             StrokeThickness="2"
                                                             HorizontalAlignment="Right"
                                                             VerticalAlignment="Bottom"
                                                             Margin="0,0,-2,-2" />
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0,6,0" Spacing="2"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="13"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Version}" Classes="caption"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Border Grid.Column="2" CornerRadius="8" Padding="7,3"
                                                    Background="{Binding StatusBg}"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StatusText}" FontSize="10"
                                                           Foreground="{Binding StatusFg}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel x:Name="ListEmptyHint" IsVisible="False"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Spacing="6" Margin="12">
                            <controls:IconParkIcon Kind="IconFluentServer" Width="34" Height="34"
                                                   HorizontalAlignment="Center" Opacity="0.45" />
                            <TextBlock x:Name="ListEmptyTitle"
                                       Text="{DynamicResource L.Servers.Empty.Title}"
                                       FontSize="13" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock x:Name="ListEmptyText"
                                       Text="{DynamicResource L.Servers.Empty.Hint}"
                                       Classes="caption" HorizontalAlignment="Center"
                                       TextAlignment="Center" TextWrapping="Wrap" />
                            <Button Classes="ghost" Height="30" Padding="12,0" Margin="0,4,0,0"
                                    HorizontalAlignment="Center"
                                    Content="{DynamicResource L.Servers.Action.NewServer}"
                                    Click="OnCreateServerClick" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Classes="card" Padding="0" Margin="12,0,0,0">
                <Grid>
                    <Grid x:Name="DetailContent" RowDefinitions="Auto,Auto,*" IsVisible="False">
                        <Border Grid.Row="0" Classes="card-soft" Padding="16" Margin="16,16,16,0">
                            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto">
                                <Border Width="54" Height="54" CornerRadius="13"
                                        Background="{DynamicResource NekoFieldSoftBrush}">
                                    <controls:IconParkIcon Kind="IconFluentServer" Width="24" Height="24"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,12,0" Spacing="3"
                                            VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock x:Name="DetailName" Text="—" FontSize="18"
                                                   FontWeight="Bold" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                        <Border x:Name="DetailBadge" CornerRadius="8" Padding="8,3"
                                                Background="{DynamicResource NekoAccentSoftBrush}"
                                                VerticalAlignment="Center">
                                            <TextBlock x:Name="DetailStatus" Text="—" FontSize="10.5"
                                                       Foreground="{DynamicResource NekoSuccessBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="DetailAddress" Text="—" Classes="caption" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                            VerticalAlignment="Center">
                                    <Button x:Name="ToggleButton" Classes="primary" Height="34"
                                            Padding="14,0" Click="OnToggleServerClick">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <controls:IconParkIcon x:Name="ToggleIcon" Kind="IconPlay"
                                                                   Width="14" Height="14" />
                                            <TextBlock x:Name="ToggleText"
                                                       Text="{DynamicResource L.Servers.Detail.Start}"
                                                       FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="RestartButton" Classes="ghost" Height="34" Padding="12,0"
                                            Click="OnRestartClick">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <controls:IconParkIcon Kind="IconFluentArrowClockwise"
                                                                   Width="13" Height="13" />
                                            <TextBlock Text="{DynamicResource L.Servers.Action.Restart}"
                                                       FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="ghost" Height="34" Width="34" Padding="0"
                                            ToolTip.Tip="{DynamicResource L.Servers.Action.CopyAddress}"
                                            Click="OnCopyAddressClick">
                                        <controls:IconParkIcon Kind="IconFluentFolder" Width="14" Height="14" />
                                    </Button>
                                </StackPanel>

                                <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                      ColumnDefinitions="*,*" Margin="0,14,0,0">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{DynamicResource L.Servers.Detail.Version}"
                                                   Classes="caption" />
                                        <TextBlock x:Name="DetailVersion" Text="—" FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{DynamicResource L.Servers.Detail.Online}"
                                                   Classes="caption" />
                                        <TextBlock x:Name="DetailPlayers" Text="—" FontSize="12.5"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4"
                                    Margin="16,12,16,0">
                            <Button x:Name="TabOverview" Tag="overview" Classes="tab-pill active"
                                    Click="OnDetailTabClick">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <controls:IconParkIcon Kind="IconFluentGrid" Width="13" Height="13" />
                                    <TextBlock Text="{DynamicResource L.Servers.Tab.Overview}" FontSize="12.5" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="TabFiles" Tag="files" Classes="tab-pill"
                                    Click="OnDetailTabClick">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <controls:IconParkIcon Kind="IconFluentFolder" Width="13" Height="13" />
                                    <TextBlock Text="{DynamicResource L.Servers.Tab.Files}" FontSize="12.5" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="TabBackups" Tag="backups" Classes="tab-pill"
                                    Click="OnDetailTabClick">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <controls:IconParkIcon Kind="IconRestore" Width="13" Height="13" />
                                    <TextBlock Text="{DynamicResource L.Servers.Tab.Backups}" FontSize="12.5" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="TabProperties" Tag="properties" Classes="tab-pill"
                                    Click="OnDetailTabClick">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <controls:IconParkIcon Kind="IconFluentSettings" Width="13" Height="13" />
                                    <TextBlock Text="{DynamicResource L.Servers.Tab.Properties}" FontSize="12.5" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="TabActions" Tag="actions" Classes="tab-pill"
                                    Click="OnDetailTabClick">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <controls:IconParkIcon Kind="IconFluentWrench" Width="13" Height="13" />
                                    <TextBlock Text="{DynamicResource L.Servers.Tab.Actions}" FontSize="12.5" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <Grid Grid.Row="2">
                            <ScrollViewer x:Name="OverviewPane" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="DetailBody" Spacing="12" Margin="16,12,16,16">

                                    <Border Classes="card-soft" Padding="14">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{DynamicResource L.Servers.Detail.Motd}"
                                                       Classes="caption" />
                                            <TextBlock x:Name="DetailMotd" Text="—" FontSize="13"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <Border Classes="card-soft" Padding="14">
                                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{DynamicResource L.Servers.Players.Card}"
                                                           Classes="section-title" FontSize="13"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{DynamicResource L.Servers.Players.Title}"
                                                           Classes="caption" VerticalAlignment="Center" />
                                            </Grid>
                                            <WrapPanel x:Name="PlayersPanel" Grid.Row="1" />
                                            <WrapPanel Grid.Row="2" Orientation="Horizontal">
                                                <TextBox x:Name="PlayerNameInput" Width="150" Height="30"
                                                         FontSize="11.5" Classes="search" Margin="0,0,6,0"
                                                         PlaceholderText="{DynamicResource L.Servers.Players.Placeholder}" />
                                                <Button Classes="ghost" Height="30" Padding="9,0"
                                                        FontSize="11" Margin="0,0,6,0"
                                                        Content="{DynamicResource L.Servers.Players.WhitelistAdd}"
                                                        x:Name="WhitelistAddButton" Click="OnWhitelistAddClick" />
                                                <Button Classes="ghost" Height="30" Padding="9,0"
                                                        FontSize="11" Margin="0,0,6,0"
                                                        Content="{DynamicResource L.Servers.Players.WhitelistRemove}"
                                                        x:Name="WhitelistRemoveButton" Click="OnWhitelistRemoveClick" />
                                                <Button Classes="ghost" Height="30" Padding="9,0"
                                                        FontSize="11" Margin="0,0,6,0"
                                                        Content="{DynamicResource L.Servers.Players.OpAdd}"
                                                        x:Name="OpAddButton" Click="OnOpAddClick" />
                                                <Button Classes="ghost" Height="30" Padding="9,0"
                                                        FontSize="11" Margin="0,0,6,0"
                                                        Content="{DynamicResource L.Servers.Players.OpRemove}"
                                                        x:Name="OpRemoveButton" Click="OnOpRemoveClick" />
                                                <Button Classes="ghost" Height="30" Padding="9,0"
                                                        FontSize="11" Margin="0,0,6,0"
                                                        Content="{DynamicResource L.Servers.Players.BanAdd}"
                                                        x:Name="BanAddButton" Click="OnBanAddClick" />
                                                <Button Classes="ghost" Height="30" Padding="9,0"
                                                        FontSize="11"
                                                        Content="{DynamicResource L.Servers.Players.BanRemove}"
                                                        x:Name="BanRemoveButton" Click="OnBanRemoveClick" />
                                            </WrapPanel>
                                        </Grid>
                                    </Border>

                                    <Border Classes="card-soft" Padding="12">
                                        <Grid RowDefinitions="Auto,*,Auto" Height="320">
                                            <Grid ColumnDefinitions="*,Auto" Margin="2,0,2,8">
                                                <StackPanel Orientation="Horizontal" Spacing="7"
                                                            VerticalAlignment="Center">
                                                    <controls:IconParkIcon Kind="IconFluentCode"
                                                                           Width="14" Height="14" />
                                                    <TextBlock Text="{DynamicResource L.Servers.Console.Card}"
                                                               Classes="section-title" FontSize="13" />
                                                </StackPanel>
                                            </Grid>
                                            <Border Grid.Row="1" Background="{DynamicResource NekoTerminalBrush}"
                                                    CornerRadius="8" Padding="8">
                                                <ScrollViewer x:Name="ConsoleScroll"
                                                              HorizontalScrollBarVisibility="Disabled"
                                                              VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl x:Name="ConsoleList">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid ColumnDefinitions="Auto,Auto,*" Margin="0,1">
                                                                    <TextBlock Text="{Binding Time}"
                                                                               Classes="caption"
                                                                               FontFamily="Consolas, Microsoft YaHei" />
                                                                    <TextBlock Grid.Column="1" Text="{Binding Level}"
                                                                               Margin="8,0,0,0" FontSize="10.5"
                                                                               Foreground="{Binding LevelBrush}"
                                                                               FontFamily="Consolas, Microsoft YaHei" />
                                                                    <TextBlock Grid.Column="2" Text="{Binding Text}"
                                                                               Margin="8,0,0,0" FontSize="11"
                                                                               Foreground="{DynamicResource NekoTerminalTextBrush}"
                                                                               FontFamily="Consolas, Microsoft YaHei"
                                                                               TextWrapping="Wrap" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Border>
                                            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                                                <TextBox x:Name="ConsoleInput" Height="30" FontSize="11.5"
                                                         FontFamily="Consolas, Microsoft YaHei"
                                                         PlaceholderText="{DynamicResource L.Servers.Console.InputPlaceholder}"
                                                         Background="{DynamicResource NekoFieldSoftBrush}"
                                                         BorderBrush="{DynamicResource NekoBorderBrush}"
                                                         KeyDown="OnConsoleInputKeyDown" />
                                                <Button Grid.Column="1" Classes="ghost" Height="30"
                                                        Padding="14,0" Margin="8,0,0,0" FontSize="11.5"
                                                        Content="{DynamicResource L.Servers.Console.Send}"
                                                        x:Name="ConsoleSendButton" Click="OnConsoleSendClick" />
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <Border Classes="card-soft" Padding="14">
                                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                                            <TextBlock Text="{DynamicResource L.Servers.Quick.Title}"
                                                       Classes="section-title" FontSize="13" />
                                            <WrapPanel Grid.Row="1">
                                                <Button Classes="ghost" Height="32" Padding="12,0"
                                                        Margin="0,0,8,8" x:Name="QuickBackupButton" Click="OnBackupClick">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <controls:IconParkIcon Kind="IconDisk" Width="13"
                                                                               Height="13" />
                                                        <TextBlock Text="{DynamicResource L.Servers.Action.BackupWorld}"
                                                                   FontSize="12" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Classes="ghost" Height="32" Padding="12,0"
                                                        Margin="0,0,8,8" x:Name="OpenFolderButton" Click="OnOpenFolderClick">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <controls:IconParkIcon Kind="IconFolder" Width="13"
                                                                               Height="13" />
                                                        <TextBlock Text="{DynamicResource L.Servers.Action.OpenFolder}"
                                                                   FontSize="12" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Classes="ghost" Height="32" Padding="12,0"
                                                        Margin="0,0,8,8" x:Name="ConfigButton" Click="OnConfigClick">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <controls:IconParkIcon Kind="IconFluentSettings" Width="13"
                                                                               Height="13" />
                                                        <TextBlock Text="{DynamicResource L.Servers.Action.Config}"
                                                                   FontSize="12" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Classes="ghost" Height="32" Padding="12,0"
                                                        Margin="0,0,8,8" x:Name="UnpairButton"
                                                        IsVisible="False" Foreground="{DynamicResource NekoDangerBrush}"
                                                        Click="OnUnpairServerClick">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <controls:IconParkIcon Kind="IconClose" Width="13"
                                                                               Height="13" />
                                                        <TextBlock Text="{DynamicResource L.Servers.Remote.Unpair}"
                                                                   FontSize="12" />
                                                    </StackPanel>
                                                </Button>
                                            </WrapPanel>
                                            <StackPanel x:Name="BackupSection" Grid.Row="2" Spacing="4">
                                                <TextBlock Text="{DynamicResource L.Servers.Backup.Title}"
                                                           Classes="caption" />
                                                <StackPanel x:Name="BackupPanel" Spacing="4" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <Grid x:Name="FilesPane" IsVisible="False" Margin="16,12,16,16"
                                  RowDefinitions="Auto,Auto,*" RowSpacing="8">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Button Classes="ghost" Height="32" Padding="11,0"
                                            x:Name="FilesUpButton" Click="OnFileUpClick">
                                        <controls:IconParkIcon Kind="IconArrowLeft" Width="13" Height="13" />
                                    </Button>
                                    <TextBlock Grid.Column="1" x:Name="FileBreadcrumb" Classes="caption"
                                               Margin="10,0" VerticalAlignment="Center" />
                                    <Button Grid.Column="2" Classes="ghost" Height="32" Padding="11,0"
                                            x:Name="FilesRefreshButton" Click="OnFilesRefreshClick">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <controls:IconParkIcon Kind="IconRefresh" Width="12" Height="12" />
                                            <TextBlock Text="{DynamicResource L.Servers.Files.Refresh}"
                                                       FontSize="11.5" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock Grid.Row="1" x:Name="FileStatus" Classes="caption" />
                                <Border Grid.Row="2" Background="{DynamicResource NekoFieldSoftBrush}"
                                        CornerRadius="10" Padding="6">
                                    <ListBox x:Name="FileList" Background="Transparent"
                                             BorderThickness="0" Padding="0"
                                             DoubleTapped="OnFileListDoubleTapped"
                                             ContextRequested="OnFileListContextRequested">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="*,Auto" Margin="6,4">
                                                    <TextBlock Text="{Binding Name}" FontSize="12"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1" Text="{Binding SizeDisplay}"
                                                               Classes="caption" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Grid>

                            <Grid x:Name="BackupPane" IsVisible="False" Margin="16,12,16,16"
                                  RowDefinitions="Auto,Auto,*" RowSpacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Classes="primary" Height="32" Padding="12,0"
                                            Content="{DynamicResource L.Servers.Rewind.Create}"
                                            Click="OnRewindCreateClick" />
                                    <Button Classes="ghost" Height="32" Padding="12,0"
                                            Content="{DynamicResource L.Servers.Rewind.Refresh}"
                                            Click="OnRewindRefreshClick" />
                                </StackPanel>
                                <TextBlock Grid.Row="1" x:Name="RewindHint" Classes="caption"
                                           TextWrapping="Wrap" />
                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="RewindPanel" Spacing="6" />
                                </ScrollViewer>
                            </Grid>

                            <Grid x:Name="PropertiesPane" IsVisible="False" Margin="16,12,16,16"
                                  RowDefinitions="*,Auto" RowSpacing="8">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="PropertiesPanel" Spacing="8" />
                                </ScrollViewer>
                                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto">
                                    <Button Classes="primary" Height="32" Padding="12,0"
                                            Content="{DynamicResource L.Servers.Properties.Save}"
                                            x:Name="PropertiesSaveButton" Click="OnPropertiesSaveClick" />
                                    <TextBlock Grid.Column="1" x:Name="PropertiesStatus" Classes="caption"
                                               Margin="10,0,0,0" VerticalAlignment="Center" />
                                    <Button Grid.Column="2" Classes="ghost" Height="32" Padding="12,0"
                                            Content="{DynamicResource L.Servers.Properties.Reload}"
                                            x:Name="PropertiesReloadButton" Click="OnPropertiesReloadClick" />
                                </Grid>
                            </Grid>

                            <StackPanel x:Name="ActionsPane" IsVisible="False" Spacing="12"
                                        Margin="16,12,16,16">
                                <Border Classes="card-soft" Padding="16">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="{DynamicResource L.Servers.Actions.Title}"
                                                   Classes="section-title" FontSize="14" />
                                        <TextBlock Text="{DynamicResource L.Servers.Actions.Hint}"
                                                   Classes="caption" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                            <Button Classes="primary" Height="34" Padding="14,0"
                                                    Content="{DynamicResource L.Servers.Actions.Export}"
                                                    Click="OnExportServerClick" />
                                            <Button Classes="ghost" Height="34" Padding="14,0"
                                                    Foreground="{DynamicResource NekoDangerBrush}"
                                                    Content="{DynamicResource L.Servers.Actions.Delete}"
                                                    Click="OnDeleteServerClick" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <StackPanel x:Name="DetailEmpty" Spacing="8" MaxWidth="320"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="64" Height="64" CornerRadius="16"
                                Background="{DynamicResource NekoFieldSoftBrush}"
                                HorizontalAlignment="Center">
                            <controls:IconParkIcon Kind="IconFluentServer" Width="28" Height="28"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" Opacity="0.6" />
                        </Border>
                        <TextBlock Text="{DynamicResource L.Servers.Detail.EmptyTitle}"
                                   FontSize="16" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{DynamicResource L.Servers.Detail.EmptyHint}"
                                   Classes="caption" TextAlignment="Center" TextWrapping="Wrap" />
                        <Button Classes="primary" Height="34" Padding="16,0" Margin="0,6,0,0"
                                HorizontalAlignment="Center"
                                Content="{DynamicResource L.Servers.Action.NewServer}"
                                Click="OnCreateServerClick" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="FileEditorOverlay" Grid.RowSpan="4" IsVisible="False"
              Background="#B3000000" ClipToBounds="True"
              Focusable="True" KeyDown="OnFileEditorOverlayKeyDown"
              PointerPressed="OnFileEditorOverlayPointerPressed">
            <Border x:Name="FileEditorCard" Margin="28"
                    MaxWidth="1200" MaxHeight="820"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Background="{DynamicResource NekoDialogBrush}"
                    BorderBrush="{DynamicResource NekoBorderBrush}" BorderThickness="1"
                    CornerRadius="16" Padding="0">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Border Padding="14,10" BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource NekoBorderBrush}">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock x:Name="FileEditorTitle" FontSize="14" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <Border x:Name="FileEditorDirty" IsVisible="False"
                                            CornerRadius="6" Padding="6,1"
                                            Background="{DynamicResource NekoWarningSoftBrush}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource L.Servers.Files.Dirty}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource NekoWarningBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="FileEditorSyntax" Classes="caption" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                        VerticalAlignment="Center">
                                <Button Classes="ghost" Width="32" Height="30" Padding="0"
                                        ToolTip.Tip="{DynamicResource L.Servers.Files.Find}"
                                        Click="OnFileFindClick">
                                    <controls:IconParkIcon Kind="IconSearch" Width="14" Height="14" />
                                </Button>
                                <Button Classes="ghost" Width="32" Height="30" Padding="0"
                                        ToolTip.Tip="{DynamicResource L.Servers.Files.Reload}"
                                        Click="OnFileReloadClick">
                                    <controls:IconParkIcon Kind="IconRestore" Width="14" Height="14" />
                                </Button>
                                <Border Width="1" Height="18" Margin="2,0"
                                        Background="{DynamicResource NekoBorderBrush}" />
                                <Button Classes="ghost" Width="30" Height="30" Padding="0"
                                        FontSize="11" Content="A−"
                                        ToolTip.Tip="{DynamicResource L.Servers.Files.ZoomOut}"
                                        Click="OnFileZoomOutClick" />
                                <Button Classes="ghost" Width="30" Height="30" Padding="0"
                                        FontSize="11" Content="A+"
                                        ToolTip.Tip="{DynamicResource L.Servers.Files.ZoomIn}"
                                        Click="OnFileZoomInClick" />
                                <ToggleButton x:Name="FileWrapToggle" Height="30" Padding="10,0"
                                              Content="{DynamicResource L.Servers.Files.WordWrap}"
                                              IsCheckedChanged="OnFileWrapChanged" />
                                <Button Classes="primary" Height="30" Padding="12,0"
                                        Content="{DynamicResource L.Servers.Files.Save}"
                                        x:Name="FileSaveButton" Click="OnFileSaveClick" />
                                <Button Classes="ghost" Height="30" Padding="12,0"
                                        Content="{DynamicResource L.Servers.Files.Close}"
                                        Click="OnFileEditorCloseClick" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Background="#0E131B" Padding="0,6,0,6">
                        <edit:TextEditor x:Name="FileEditor"
                                         ShowLineNumbers="True"
                                         FontFamily="Consolas, Microsoft YaHei"
                                         FontSize="13"
                                         Background="#0E131B"
                                         Foreground="#D4D4D4"
                                         LineNumbersForeground="#6E7681"
                                         WordWrap="False"
                                         TextChanged="OnFileEditorTextChanged"
                                         KeyDown="OnFileEditorKeyDown"
                                         PointerWheelChanged="OnFileEditorPointerWheelChanged" />
                    </Border>
                    <Border Grid.Row="2" Padding="14,8"
                            BorderThickness="0,1,0,0"
                            BorderBrush="{DynamicResource NekoBorderBrush}">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBlock x:Name="FileEditorStatus" Classes="caption" />
                            <TextBlock Grid.Column="1" x:Name="FileEditorZoom" Classes="caption"
                                       Margin="0,0,12,0" />
                            <TextBlock Grid.Column="2" x:Name="FileEditorCaret" Classes="caption" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
