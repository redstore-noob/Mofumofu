<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Mofumofu.Launcher.Controls"
             xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
             mc:Ignorable="d" d:DesignWidth="1240" d:DesignHeight="720"
             x:Class="Mofumofu.Launcher.Views.OnlineView">
    <UserControl.Styles>
        <Style Selector="Border.chip">
            <Setter Property="Background" Value="{DynamicResource NekoFieldSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NekoBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="12,5" />
        </Style>
        <Style Selector="Border.chip.accent">
            <Setter Property="Background" Value="{DynamicResource NekoAccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NekoAccentLineBrush}" />
        </Style>
        <Style Selector="Border.provider-icon">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{DynamicResource NekoAccentSoftBrush}" />
        </Style>
        <Style Selector="TextBlock.room-code">
            <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Microsoft YaHei" />
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource NekoAccentBrush}" />
        </Style>
        <Style Selector="Border.room-box">
            <Setter Property="Background" Value="{DynamicResource NekoFieldSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NekoAccentLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,14" />
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="{DynamicResource NekoDangerSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NekoDangerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Foreground" Value="{DynamicResource NekoDangerBrush}" />
            <Setter Property="Padding" Value="14,7" />
        </Style>
        <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource NekoDangerBrush}" />
        </Style>
        <Style Selector="TextBlock.field-label">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource NekoMutedBrush}" />
        </Style>
        <Style Selector="TextBlock.badge-text">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*">
        <controls:PageHeader Title="{DynamicResource L.Pages.Online.Title}"
>
            <controls:PageHeader.Actions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="ghost" Height="34" Padding="12,0" Click="OnRefreshClick">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <controls:IconParkIcon Kind="IconRefresh" Width="13" Height="13" />
                            <TextBlock Text="{DynamicResource L.Common.Refresh}" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Button Classes="ghost" Height="34" Padding="12,0" Click="OnToggleSettingsClick">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <controls:IconParkIcon Kind="IconSettings" Width="13" Height="13" />
                            <TextBlock Text="{DynamicResource L.Pages.Online.Settings}" FontSize="12" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </controls:PageHeader.Actions>
        </controls:PageHeader>

        <!-- ============ 状态行 ============ -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
            <Border x:Name="StatusChip" Classes="chip" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                    <Border x:Name="StatusDot" Width="7" Height="7" CornerRadius="4"
                            Background="{DynamicResource NekoDimBrush}" />
                    <TextBlock x:Name="StatusText" Text="{DynamicResource L.Pages.Online.Status.Idle}" FontSize="11.5"
                               Foreground="{DynamicResource NekoMutedBrush}" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                        Margin="10,0,0,0" VerticalAlignment="Center">
                <Border x:Name="ProviderBadge" Classes="chip" Padding="10,4">
                    <TextBlock x:Name="ProviderBadgeText" Text="{DynamicResource L.Pages.Online.Provider.None}"
                               Classes="badge-text"
                               Foreground="{DynamicResource NekoMutedBrush}" />
                </Border>
                <Border x:Name="ModBadge" Classes="chip" Padding="10,4">
                    <TextBlock Text="{DynamicResource L.Pages.Online.Badge.HostNeedsMod}" Classes="badge-text"
                               Foreground="{DynamicResource NekoWarningBrush}" />
                </Border>
                <Border Classes="chip" Padding="10,4">
                    <TextBlock x:Name="OnlinePlayersText" Text="2" Classes="badge-text"
                               Foreground="{DynamicResource NekoMutedBrush}" />
                </Border>
            </StackPanel>

            <TextBlock Grid.Column="2" x:Name="SessionHint"
                       Text="{DynamicResource L.Pages.Online.Session.None}"
                       Classes="caption" VerticalAlignment="Center" />
        </Grid>

        <!-- ============ 主体：供应商卡 + 联机设置 ============ -->
        <Grid Grid.Row="2" x:Name="BodyGrid" ColumnDefinitions="*,Auto">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                          Margin="0,0,12,0">
                <StackPanel Spacing="12">

                    <!-- ====== 陶瓦联机 ====== -->
                    <suki:GlassCard CornerRadius="12" Padding="20">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border Classes="provider-icon">
                                    <controls:IconParkIcon Kind="IconGlobe" Width="20" Height="20" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,12,0" Spacing="2"
                                            VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock x:Name="TerracottaName"
                                                   Text="{DynamicResource L.Pages.Online.Provider.Terracotta.Name}"
                                                   FontSize="15" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                        <Border x:Name="TerracottaReadyBadge" Classes="chip" Padding="8,2"
                                                VerticalAlignment="Center">
                                            <TextBlock x:Name="TerracottaReadyBadgeText"
                                                       Classes="badge-text"
                                                       Foreground="{DynamicResource NekoSuccessBrush}" />
                                        </Border>
                                        <Border x:Name="TerracottaModBadge" Classes="chip" Padding="8,2"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource L.Pages.Online.Badge.HostNeedsMod}"
                                                       Classes="badge-text"
                                                       Foreground="{DynamicResource NekoWarningBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="TerracottaSummary"
                                               Text="{DynamicResource L.Pages.Online.Provider.Terracotta.Summary}"
                                               Classes="caption" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="2" Classes="ghost" Height="30" Padding="10,0"
                                        VerticalAlignment="Center"
                                        Tag="https://github.com/burningtnt/Terracotta"
                                        Click="OnProviderHomepageClick">
                                    <StackPanel Orientation="Horizontal" Spacing="5"
                                                VerticalAlignment="Center">
                                        <controls:IconParkIcon Kind="IconGlobe" Width="12" Height="12" />
                                        <TextBlock Text="{DynamicResource L.Pages.Online.Homepage}" FontSize="11.5" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Border Classes="divider" />

                            <TextBlock x:Name="TerracottaNote"
                                       Text="{DynamicResource L.Pages.Online.Provider.Terracotta.HostNote}"
                                       Classes="muted" FontSize="11.5" TextWrapping="Wrap" />

                            <StackPanel x:Name="TerracottaIdle" Orientation="Horizontal" Spacing="8">
                                <Button Classes="primary" Height="36" Padding="16,0"
                                        Click="OnCreateTerracottaClick">
                                    <StackPanel Orientation="Horizontal" Spacing="6"
                                                VerticalAlignment="Center">
                                        <controls:IconParkIcon Kind="IconPlus" Width="13" Height="13" />
                                        <TextBlock Text="{DynamicResource L.Pages.Online.CreateRoom}" FontSize="12.5" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="ghost" Height="36" Padding="14,0" Click="OnJoinFromCardClick">
                                    <StackPanel Orientation="Horizontal" Spacing="6"
                                                VerticalAlignment="Center">
                                        <controls:IconParkIcon Kind="IconArrowRight" Width="13"
                                                  Height="13" />
                                        <TextBlock Text="{DynamicResource L.Pages.Online.JoinRoom}" FontSize="12.5" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <StackPanel x:Name="TerracottaReady" IsVisible="False" Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{DynamicResource L.Pages.Online.Room.Mine}" FontSize="13.5" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                            <Border Classes="chip accent" Padding="8,2"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{DynamicResource L.Pages.Online.Room.Ready}" Classes="badge-text"
                                                           Foreground="{DynamicResource NekoAccentBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock x:Name="TerracottaDetail" Classes="caption" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="danger" Height="32" Padding="12,0"
                                            VerticalAlignment="Center" Click="OnExitRoomClick">
                                        <StackPanel Orientation="Horizontal" Spacing="6"
                                                    VerticalAlignment="Center">
                                            <controls:IconParkIcon Kind="IconClose" Width="12"
                                                      Height="12" />
                                            <TextBlock Text="{DynamicResource L.Pages.Online.Room.Exit}" FontSize="11.5" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <Border Classes="room-box">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="{DynamicResource L.Pages.Online.Room.Code}" Classes="caption"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock x:Name="TerracottaCode" Text="—" Classes="room-code"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock x:Name="TerracottaAddress" Text="—"
                                                   Classes="caption" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{DynamicResource L.Pages.Online.Room.HintTerracotta}" Classes="caption" />
                            </StackPanel>
                        </StackPanel>
                    </suki:GlassCard>

                    <!-- ====== 加入房间 ====== -->
                    <suki:GlassCard CornerRadius="12" Padding="20">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{DynamicResource L.Pages.Online.Join.SectionTitle}" Classes="section-title" />
                                    <TextBlock Text="{DynamicResource L.Pages.Online.Join.Hint}"
                                               Classes="caption" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{DynamicResource L.Pages.Online.Join.Guest}" Classes="caption"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox x:Name="JoinCodeBox" Height="36"
                                         PlaceholderText="{DynamicResource L.Pages.Online.Join.Placeholder}" />
                                <Button Grid.Column="1" Margin="8,0,0,0" Classes="primary" Height="36"
                                        Padding="20,0" Content="{DynamicResource L.Pages.Online.Join.Button}"
                                        Click="OnJoinRoomClick" />
                            </Grid>
                        </StackPanel>
                    </suki:GlassCard>
                </StackPanel>
            </ScrollViewer>

            <!-- ====== 右侧：联机设置面板 ====== -->
            <ScrollViewer Grid.Column="1" x:Name="SettingsPanel" Width="318"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <suki:GlassCard CornerRadius="12" Padding="18">
                    <StackPanel Spacing="14">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{DynamicResource L.Pages.Online.SettingsPanel.Title}" Classes="section-title" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Classes="icon" Width="28" Height="28"
                                    ToolTip.Tip="{DynamicResource L.Pages.Online.SettingsPanel.Save}"
                                    Click="OnSaveSettingsClick">
                                <controls:IconParkIcon Kind="IconCheck" Width="14" Height="14" />
                            </Button>
                        </Grid>

                        <StackPanel Spacing="5">
                            <TextBlock Text="{DynamicResource L.Pages.Online.Nickname}" Classes="field-label" />
                            <TextBox x:Name="NicknameBox" Height="34"
                                     PlaceholderText="{DynamicResource L.Pages.Online.NicknamePlaceholder}" />
                        </StackPanel>

                        <StackPanel Spacing="5">
                            <TextBlock Text="{DynamicResource L.Pages.Online.ProviderLabel}" Classes="field-label" />
                            <ComboBox x:Name="ProviderCombo" HorizontalAlignment="Stretch"
                                      SelectedIndex="0" SelectionChanged="OnProviderChanged">
                                <ComboBoxItem Content="{DynamicResource L.Pages.Online.Provider.TerracottaOption}" />
                            </ComboBox>
                        </StackPanel>

                        <Border Classes="card-soft" Padding="13">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <controls:IconParkIcon Kind="IconServer" Width="14" Height="14" />
                                    <TextBlock x:Name="ServiceTitle"
                                               Text="{DynamicResource L.Pages.Online.Provider.Terracotta.Name}"
                                               FontSize="12.5" FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="ServiceStatusText"
                                           Text="{DynamicResource L.Pages.Online.Service.NotRunning}"
                                           FontSize="11.5" Foreground="{DynamicResource NekoMutedBrush}" />
                                <TextBlock x:Name="ServicePathText"
                                           Text="C:\Program Files\Terracotta\terracotta.exe"
                                           Classes="caption" TextTrimming="CharacterEllipsis" />
                                <Button x:Name="AutoInstallButton" Classes="primary" Height="34"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Click="OnAutoInstallClick">
                                    <StackPanel Orientation="Horizontal" Spacing="6"
                                                VerticalAlignment="Center">
                                        <controls:IconParkIcon Kind="IconDownload" Width="13"
                                                  Height="13" />
                                        <TextBlock Text="{DynamicResource L.Pages.Online.Service.AutoInstall}" FontSize="12" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="ghost" Height="32" HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center" Click="OnPickExecutableClick">
                                    <StackPanel Orientation="Horizontal" Spacing="6"
                                                VerticalAlignment="Center">
                                        <controls:IconParkIcon Kind="IconFolder" Width="13" Height="13" />
                                        <TextBlock Text="{DynamicResource L.Pages.Online.Service.Pick}" FontSize="11.5" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="ghost" Height="32" HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center" Click="OnRecheckServiceClick">
                                    <StackPanel Orientation="Horizontal" Spacing="6"
                                                VerticalAlignment="Center">
                                        <controls:IconParkIcon Kind="IconRefresh" Width="13" Height="13" />
                                        <TextBlock Text="{DynamicResource L.Pages.Online.Service.Recheck}" FontSize="11.5" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="danger" Height="32" HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center" Click="OnStopServiceClick">
                                    <StackPanel Orientation="Horizontal" Spacing="6"
                                                VerticalAlignment="Center">
                                        <controls:IconParkIcon Kind="IconClose" Width="12" Height="12" />
                                        <TextBlock Text="{DynamicResource L.Pages.Online.Service.Stop}" FontSize="11.5" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>


                    </StackPanel>
                </suki:GlassCard>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
