<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Mofumofu.Launcher.Controls"
             x:Class="Mofumofu.Launcher.Views.GalleryView"
             Background="Transparent">

    <Grid RowDefinitions="Auto,*">
        
        <controls:PageHeader>
            <controls:PageHeader.Actions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="ghost" Height="36" Padding="12,0" Click="OnRefreshClick">
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <controls:IconParkIcon Kind="IconRefresh" Width="14" Height="14" />
                            <TextBlock x:Name="RefreshText" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Button Classes="ghost" Height="36" Padding="12,0" Click="OnOpenFolderClick">
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <controls:IconParkIcon Kind="IconFolder" Width="14" Height="14" />
                            <TextBlock x:Name="OpenFolderText" FontSize="12" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </controls:PageHeader.Actions>
        </controls:PageHeader>

        <Grid Grid.Row="1" ColumnDefinitions="224,*" ColumnSpacing="12">
            
            <Border Classes="card" Padding="10">
                <Grid RowDefinitions="Auto,*">
                    <StackPanel Margin="4,2,4,8" Spacing="2">
                        <TextBlock x:Name="TitleText" Classes="section-title" />
                        <TextBlock x:Name="SummaryText" Classes="caption" TextWrapping="Wrap" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="FilterHost" Spacing="3" />
                    </ScrollViewer>
                </Grid>
            </Border>

            
            <Border Grid.Column="1" Classes="card" Padding="12">
                <Grid>
                    <ScrollViewer x:Name="ScrollHost" VerticalScrollBarVisibility="Auto">
                        <WrapPanel x:Name="TileHost" />
                    </ScrollViewer>

                    <StackPanel x:Name="EmptyPanel" IsVisible="False" Spacing="10"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                MaxWidth="360">
                        <controls:IconParkIcon Kind="IconFluentImage" Width="30" Height="30"
                                               HorizontalAlignment="Center" Opacity="0.7" />
                        <TextBlock x:Name="EmptyText" Classes="caption" TextWrapping="Wrap"
                                   TextAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
