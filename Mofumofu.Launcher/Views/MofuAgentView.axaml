<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Mofumofu.Launcher.Controls"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
             x:Class="Mofumofu.Launcher.Views.MofuAgentView"
             Background="Transparent">

    <UserControl.Styles>
        <!-- 对话正文排版 -->
        <Style Selector="TextBlock.agent-body">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource NekoTextBrush}" />
            <Setter Property="LineHeight" Value="21" />
        </Style>
        <Style Selector="TextBlock.agent-h1">
            <Setter Property="FontSize" Value="15.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource NekoTextBrush}" />
        </Style>
        <Style Selector="TextBlock.agent-h2">
            <Setter Property="FontSize" Value="13.8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource NekoTextBrush}" />
        </Style>
        <Style Selector="TextBlock.agent-marker">
            <Setter Property="Foreground" Value="{DynamicResource NekoDimBrush}" />
            <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,Menlo,monospace" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="TextBlock.agent-quote">
            <Setter Property="Foreground" Value="{DynamicResource NekoMutedBrush}" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>
        <Style Selector="Border.agent-quote-card">
            <Setter Property="BorderThickness" Value="2,0,0,0" />
            <Setter Property="BorderBrush" Value="{DynamicResource NekoAccentLineBrush}" />
            <Setter Property="Background" Value="{DynamicResource NekoFieldSoftBrush}" />
            <Setter Property="CornerRadius" Value="0,8,8,0" />
            <Setter Property="Padding" Value="10,7" />
        </Style>
        <Style Selector="Border.agent-code-card">
            <Setter Property="Background" Value="{DynamicResource NekoTerminalBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NekoBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="11,8,11,10" />
        </Style>
        <Style Selector="TextBlock.agent-code">
            <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,Menlo,monospace" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource NekoTerminalTextBrush}" />
            <Setter Property="LineHeight" Value="19" />
        </Style>
        <Style Selector="TextBlock.agent-code-lang">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="1.1" />
            <Setter Property="Foreground" Value="{DynamicResource NekoMutedBrush}" />
        </Style>
        <Style Selector="Button.agent-mini">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Height" Value="22" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Background" Value="{DynamicResource NekoFieldBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource NekoMutedBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource NekoBorderBrush}" />
        </Style>
        <Style Selector="Button.agent-mini:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NekoControlHoverBrush}" />
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource NekoTextBrush}" />
        </Style>
        <Style Selector="Border.agent-table-card">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource NekoBorderBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="Background" Value="{DynamicResource NekoFieldSoftBrush}" />
        </Style>
        <Style Selector="TextBlock.agent-table-cell">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Foreground" Value="{DynamicResource NekoTextBrush}" />
        </Style>
        <Style Selector="TextBlock.agent-table-head">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource NekoMutedBrush}" />
        </Style>

        <!-- 侧栏行 / 标签 -->
        <Style Selector="Border.agent-row">
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2,0,0,0" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Border.agent-row:pointerover">
            <Setter Property="Background" Value="{DynamicResource NekoFieldHoverBrush}" />
        </Style>
        <Style Selector="Border.agent-row.active">
            <Setter Property="Background" Value="{DynamicResource NekoAccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NekoAccentBrush}" />
        </Style>
        <Style Selector="TextBlock.agent-label">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="1.4" />
            <Setter Property="Foreground" Value="{DynamicResource NekoDimBrush}" />
        </Style>
        <Style Selector="TextBlock.agent-mono">
            <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,Menlo,monospace" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource NekoMutedBrush}" />
        </Style>
        <Style Selector="TextBlock.agent-metric">
            <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,Menlo,monospace" />
            <Setter Property="FontSize" Value="21" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource NekoTextBrush}" />
        </Style>
        <Style Selector="TextBlock.session-group">
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="1.3" />
            <Setter Property="Foreground" Value="{DynamicResource NekoDimBrush}" />
            <Setter Property="Margin" Value="7,9,0,3" />
        </Style>
        <Style Selector="TextBox.agent-field">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="9,5" />
        </Style>
        <Style Selector="ComboBox.agent-field">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="8,3" />
        </Style>
        <Style Selector="ComboBoxItem">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Padding" Value="10,6" />
        </Style>

        <Style Selector="Button.icon.active /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NekoAccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NekoAccentLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <!-- 空状态任务卡 -->
        <Style Selector="Button.agent-suggestion">
            <Setter Property="Background" Value="{DynamicResource NekoFieldSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NekoBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>
        <Style Selector="Button.agent-suggestion:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NekoFieldHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NekoAccentLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- 仪表卡片 -->
        <Style Selector="Border.meter-card">
            <Setter Property="Background" Value="{DynamicResource NekoCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NekoBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Padding" Value="13,11" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">
        <!-- 页头：标题 + 模型工具栏 -->
        <Grid ColumnDefinitions="Auto,*,Auto" Height="56" Margin="0,0,0,12">
            <Button Classes="round" Width="32" Height="32" VerticalAlignment="Center"
                    Click="OnBackToDesktop" ToolTip.Tip="回到桌面">
                <controls:IconParkIcon Kind="IconArrowLeft" Width="15" Height="15" />
            </Button>

            <StackPanel Grid.Column="1" Margin="11,0,12,0" VerticalAlignment="Center" Spacing="1">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <TextBlock Text="MofuAgent" FontSize="21" FontWeight="Bold" LetterSpacing="-0.2" />
                    <Border CornerRadius="4" Padding="5,1" VerticalAlignment="Center"
                            Background="{DynamicResource NekoAccentSoftBrush}"
                            BorderBrush="{DynamicResource NekoAccentLineBrush}" BorderThickness="1">
                        <TextBlock Text="AGENT" FontSize="8.5" FontWeight="Bold" LetterSpacing="1.2"
                                   Foreground="{DynamicResource NekoAccentBrush}" />
                    </Border>
                </StackPanel>
                <TextBlock Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis"
                           Text="内置智能体 · 读实例状态，也能直接操作启动器" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <ComboBox x:Name="ProviderCombo" Classes="agent-field" Width="142" Height="30"
                          VerticalAlignment="Center" SelectionChanged="OnProviderChanged"
                          PlaceholderText="供应商" ToolTip.Tip="供应商" />
                <ComboBox x:Name="ModelCombo" Classes="agent-field" Width="158" Height="30"
                          VerticalAlignment="Center" SelectionChanged="OnModelChanged"
                          PlaceholderText="模型" ToolTip.Tip="模型" />
                <Border Width="1" Height="18" Background="{DynamicResource NekoBorderBrush}"
                        Margin="2,0" VerticalAlignment="Center" />
                <Button x:Name="AddProviderButton" Classes="icon" Width="30" Height="30"
                        VerticalAlignment="Center" Click="OnAddProvider" ToolTip.Tip="添加供应商">
                    <controls:IconParkIcon Kind="IconPlus" Width="14" Height="14" />
                </Button>
                <Button x:Name="InspectorToggleButton" Classes="icon" Width="30" Height="30"
                        VerticalAlignment="Center" Click="OnToggleInspector" ToolTip.Tip="收起/展开上下文仪表">
                    <controls:IconParkIcon Kind="IconFluentGrid" Width="14" Height="14" />
                </Button>
                <Button x:Name="SettingsButton" Classes="icon" Width="30" Height="30"
                        VerticalAlignment="Center" Click="OnOpenSettings" ToolTip.Tip="设置">
                    <controls:IconParkIcon Kind="IconFluentSettings" Width="14" Height="14" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid x:Name="WorkspaceGrid" Grid.Row="1" ColumnDefinitions="244,*,288" ColumnSpacing="12">

            <!-- 左：会话栏 -->
            <Border Classes="card" CornerRadius="11" Padding="9">
                <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="7">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="1">
                            <TextBlock Classes="agent-label" Text="会话" />
                            <TextBlock x:Name="SessionCountText" Classes="caption" Text="0 条" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="icon" Width="26" Height="26" Click="OnNewChat"
                                ToolTip.Tip="新对话">
                            <controls:IconParkIcon Kind="IconPlus" Width="12" Height="12" />
                        </Button>
                    </Grid>

                    <Button x:Name="NewChatButton" Grid.Row="1" Classes="ghost" Height="31"
                            HorizontalAlignment="Stretch" Click="OnNewChat">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                            <controls:IconParkIcon Kind="IconFluentChat" Width="12" Height="12" />
                            <TextBlock Text="新建对话" FontSize="11.5" />
                        </StackPanel>
                    </Button>

                    <TextBox x:Name="SessionSearchBox" Grid.Row="2" Classes="search agent-field" Height="29"
                             Watermark="搜索会话" TextChanged="OnSessionSearchChanged" />

                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="SessionList" Spacing="1" />
                    </ScrollViewer>

                    <StackPanel Grid.Row="4" Spacing="5" Margin="2,3,2,0">
                        <Border Classes="divider" />
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="0">
                                <TextBlock Classes="agent-label" Text="本地记忆" />
                                <TextBlock x:Name="MemoryCountText" Classes="caption" Text="0 条" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="agent-mini" Content="查看"
                                    Click="OnShowMemory" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 中：对话 -->
            <Border Grid.Column="1" Classes="card" CornerRadius="11" Padding="0" ClipToBounds="True">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- 对话标题条 -->
                    <Grid ColumnDefinitions="*,Auto" Margin="15,11,10,8">
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Name="ConversationTitle" FontSize="13.5" FontWeight="SemiBold"
                                       Text="新对话" TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse x:Name="HeaderStatusDot" Width="5" Height="5"
                                         Fill="{DynamicResource NekoSuccessBrush}"
                                         VerticalAlignment="Center" />
                                <TextBlock x:Name="HeaderStatusText" Classes="caption" Text="就绪"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="·" Classes="caption" />
                                <TextBlock x:Name="ConversationMeta" Classes="caption" Text="尚未开始" />
                                <TextBlock Text="·" Classes="caption" />
                                <TextBlock x:Name="ContextPill" Classes="caption" Text="0 / 32k" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="1">
                            <Button Classes="icon" Width="27" Height="27" Click="OnRegenerate"
                                    ToolTip.Tip="重新生成上一条">
                                <controls:IconParkIcon Kind="IconFluentArrowClockwise" Width="12" Height="12" />
                            </Button>
                            <Button Classes="icon" Width="27" Height="27" Click="OnExportConversation"
                                    ToolTip.Tip="导出为 Markdown">
                                <controls:IconParkIcon Kind="IconFluentDocument" Width="12" Height="12" />
                            </Button>
                            <Button Classes="icon" Width="27" Height="27" Click="OnClearConversation"
                                    ToolTip.Tip="清空当前会话">
                                <controls:IconParkIcon Kind="IconFluentDismiss" Width="12" Height="12" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- 消息流 -->
                    <ScrollViewer x:Name="MessagesScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Padding="15,0,11,0">
                        <StackPanel x:Name="MessagePanel" Spacing="16" Margin="0,4,0,12" />
                    </ScrollViewer>

                    <!-- 空状态：左对齐的入口面板 -->
                    <StackPanel x:Name="EmptyState" Grid.Row="1" VerticalAlignment="Center"
                                HorizontalAlignment="Left" Spacing="16" MaxWidth="560" Margin="26,0,20,0">
                        <StackPanel Spacing="7">
                            <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left"
                                    Background="{DynamicResource NekoFieldSoftBrush}"
                                    BorderBrush="{DynamicResource NekoBorderBrush}" BorderThickness="1">
                                <TextBlock Text="READY / MOFUAGENT" FontFamily="Cascadia Mono,Consolas,monospace"
                                           FontSize="9" LetterSpacing="1.4"
                                           Foreground="{DynamicResource NekoAccentBrush}" />
                            </Border>
                            <TextBlock Text="让启动器替你做点事。" FontSize="24" FontWeight="Bold"
                                       LetterSpacing="-0.4" TextWrapping="Wrap" />
                            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" LineHeight="19"
                                       Text="读实例、启动游戏、跳转页面。工具调用前会先征求你的同意。" />
                            <TextBlock x:Name="EmptyModelHint" FontFamily="Cascadia Mono,Consolas,monospace"
                                       FontSize="10.5" Foreground="{DynamicResource NekoDimBrush}"
                                       Text="本地模拟 / mofu-sim-1" />
                        </StackPanel>

                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" Margin="0,2,0,0">
                            <Button Grid.Row="0" Grid.Column="0" Classes="agent-suggestion"
                                    Tag="帮我看看有哪些实例" Click="OnSuggestionClick">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Border Width="30" Height="30" CornerRadius="7"
                                            Background="{DynamicResource NekoAccentSoftBrush}"
                                            BorderBrush="{DynamicResource NekoAccentLineBrush}" BorderThickness="1"
                                            VerticalAlignment="Center">
                                        <controls:IconParkIcon Kind="IconFluentList" Width="14" Height="14" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="9,0,0,0" Spacing="1"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="查看实例" FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock Text="列出实例与加载器" FontSize="10"
                                                   Foreground="{DynamicResource NekoDimBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Button Grid.Row="0" Grid.Column="1" Classes="agent-suggestion"
                                    Tag="启动当前选中的实例" Click="OnSuggestionClick">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Border Width="30" Height="30" CornerRadius="7"
                                            Background="{DynamicResource NekoSuccessSoftBrush}"
                                            VerticalAlignment="Center">
                                        <controls:IconParkIcon Kind="IconFluentPlay" Width="14" Height="14" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="9,0,0,0" Spacing="1"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="启动游戏" FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock Text="打开选中实例" FontSize="10"
                                                   Foreground="{DynamicResource NekoDimBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Button Grid.Row="1" Grid.Column="0" Classes="agent-suggestion"
                                    Tag="现在启动器是什么状态" Click="OnSuggestionClick">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Border Width="30" Height="30" CornerRadius="7"
                                            Background="{DynamicResource NekoInfoSoftBrush}"
                                            VerticalAlignment="Center">
                                        <controls:IconParkIcon Kind="IconFluentTimer" Width="14" Height="14" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="9,0,0,0" Spacing="1"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="检查状态" FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock Text="内存 / Java / 登录" FontSize="10"
                                                   Foreground="{DynamicResource NekoDimBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Button Grid.Row="1" Grid.Column="1" Classes="agent-suggestion"
                                    Tag="你能做什么" Click="OnSuggestionClick">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Border Width="30" Height="30" CornerRadius="7"
                                            Background="{DynamicResource NekoWarningSoftBrush}"
                                            VerticalAlignment="Center">
                                        <controls:IconParkIcon Kind="IconFluentSparkle" Width="14" Height="14" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="9,0,0,0" Spacing="1"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="能力清单" FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock Text="工具与用法示例" FontSize="10"
                                                   Foreground="{DynamicResource NekoDimBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </Grid>

                        <TextBlock Classes="caption" Text="Enter 发送 · Shift+Enter 换行" />
                    </StackPanel>

                    <!-- 输入区 -->
                    <Border Grid.Row="2" BorderThickness="0,1,0,0"
                            BorderBrush="{DynamicResource NekoBorderBrush}"
                            Background="{DynamicResource NekoFieldSoftBrush}" Padding="12,9">
                        <StackPanel Spacing="6">
                            <Border x:Name="ComposerShell" CornerRadius="9" BorderThickness="1"
                                    BorderBrush="{DynamicResource NekoBorderBrush}"
                                    Background="{DynamicResource NekoFieldBrush}" Padding="10,4,6,4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox x:Name="ComposerBox" Classes="agent-field"
                                             AcceptsReturn="True" TextWrapping="Wrap"
                                             MinHeight="52" MaxHeight="132"
                                             BorderThickness="0" Background="Transparent"
                                             VerticalContentAlignment="Top"
                                             Watermark="问点什么，或者让我去操作启动器…"
                                             KeyDown="OnComposerKeyDown" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                                VerticalAlignment="Bottom" Margin="6,0,0,6">
                                        <Button x:Name="StopButton" Classes="ghost" Height="30" Padding="9,0"
                                                IsVisible="False" Click="OnStopGenerating">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <controls:IconParkIcon Kind="IconStop" Width="11" Height="11" />
                                                <TextBlock Text="停止" FontSize="11.5" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="SendButton" Classes="primary" Height="30" Padding="12,0"
                                                Click="OnSend">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <controls:IconParkIcon Kind="IconArrowRight" Width="12" Height="12" />
                                                <TextBlock Text="发送" FontSize="11.5" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="caption" FontSize="10.5"
                                           Text="工具调用前会征求同意 · 写入操作可直接拒绝" />
                                <TextBlock x:Name="ComposerHint" Grid.Column="1" Classes="caption"
                                           FontSize="10.5" Text="上下文 0%" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 右：上下文仪表 -->
            <ScrollViewer x:Name="InspectorPanel" Grid.Column="2" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="10">
                    <!-- 上下文 -->
                    <Border Classes="meter-card">
                        <StackPanel Spacing="9">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="agent-label" Text="上下文" VerticalAlignment="Center" />
                                <Border Grid.Column="1" CornerRadius="4" Padding="6,1"
                                        Background="{DynamicResource NekoFieldBrush}">
                                    <TextBlock x:Name="ContextPercentText" Classes="agent-mono" Text="0%" />
                                </Border>
                            </Grid>

                            <StackPanel Spacing="1">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock x:Name="ContextUsedText" Classes="agent-metric" Text="0" />
                                    <TextBlock x:Name="ContextWindowText" Classes="agent-mono" Text="/ 32k"
                                               VerticalAlignment="Bottom" Margin="0,0,0,4" />
                                </StackPanel>
                                <TextBlock Classes="caption" Text="token 占用（估算）" />
                            </StackPanel>

                            <Border CornerRadius="3" ClipToBounds="True" Height="6"
                                    Background="{DynamicResource NekoFieldBrush}">
                                <Grid x:Name="ContextComposition" ColumnDefinitions="1*,1*,1*">
                                    <Border x:Name="SystemSegment" Background="{DynamicResource NekoMutedBrush}"
                                            Grid.Column="0" />
                                    <Border x:Name="ToolSegment" Background="{DynamicResource NekoWarningBrush}"
                                            Grid.Column="1" />
                                    <Border x:Name="MessageSegment" Background="{DynamicResource NekoAccentBrush}"
                                            Grid.Column="2" />
                                </Grid>
                            </Border>

                            <StackPanel Spacing="5" Margin="0,2,0,0">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border Width="5" Height="5" CornerRadius="1" Margin="0,0,7,0"
                                            Background="{DynamicResource NekoMutedBrush}"
                                            VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Classes="agent-mono" Text="系统提示" />
                                    <TextBlock x:Name="SystemTokensText" Grid.Column="2" Classes="agent-mono"
                                               Text="0" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border Width="5" Height="5" CornerRadius="1" Margin="0,0,7,0"
                                            Background="{DynamicResource NekoWarningBrush}"
                                            VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Classes="agent-mono" Text="工具描述" />
                                    <TextBlock x:Name="ToolTokensText" Grid.Column="2" Classes="agent-mono"
                                               Text="0" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border Width="5" Height="5" CornerRadius="1" Margin="0,0,7,0"
                                            Background="{DynamicResource NekoAccentBrush}"
                                            VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Classes="agent-mono" Text="消息历史" />
                                    <TextBlock x:Name="MessageTokensText" Grid.Column="2" Classes="agent-mono"
                                               Text="0" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="agent-mono" Text="上次返回" />
                                    <TextBlock x:Name="UsageDetailText" Grid.Column="1" Classes="agent-mono"
                                               Text="—" />
                                </Grid>
                            </StackPanel>

                            <Border Classes="divider" />

                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="1">
                                    <TextBlock Text="自动压缩" FontSize="11.5" />
                                    <TextBlock Classes="caption" FontSize="10" Text="接近上限时折叠较早消息" />
                                </StackPanel>
                                <ToggleSwitch x:Name="AutoCompactSwitch" Grid.Column="1" OnContent="" OffContent=""
                                              IsCheckedChanged="OnAutoCompactToggled" />
                            </Grid>

                            <Button x:Name="CompactNowButton" Classes="ghost" Height="27" Padding="10,0"
                                    Content="立即压缩" FontSize="11" Click="OnCompactNow" />
                        </StackPanel>
                    </Border>

                    <!-- 工具 -->
                    <Border Classes="meter-card">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="agent-label" Text="工具" VerticalAlignment="Center" />
                                <TextBlock x:Name="ToolCountText" Grid.Column="1" Classes="agent-mono" Text="0 个" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="1">
                                    <TextBlock Text="允许操作启动器" FontSize="11.5" />
                                    <TextBlock Classes="caption" FontSize="10" Text="关掉后只聊天，不碰任何功能" />
                                </StackPanel>
                                <ToggleSwitch x:Name="LauncherToolsSwitch" Grid.Column="1" OnContent="" OffContent=""
                                              IsCheckedChanged="OnLauncherToolsToggled" />
                            </Grid>
                            <Border Classes="divider" />
                            <StackPanel x:Name="RecentToolsPanel" Spacing="4" />
                        </StackPanel>
                    </Border>

                    <!-- 采样参数 -->
                    <Border Classes="meter-card">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="agent-label" Text="生成" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="温度" FontSize="11.5" VerticalAlignment="Center" />
                                <TextBlock x:Name="TempValueText" Grid.Column="1" Classes="agent-mono" Text="0.35" />
                            </Grid>
                            <Slider x:Name="TempSlider" Minimum="0" Maximum="2" Value="0.35" Height="20"
                                    ValueChanged="OnTemperatureChanged" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="最大输出" FontSize="11.5" VerticalAlignment="Center" />
                                <TextBlock x:Name="MaxTokensText" Grid.Column="1" Classes="agent-mono" Text="2048" />
                            </Grid>
                            <Slider x:Name="MaxTokensSlider" Minimum="256" Maximum="16384" Value="2048" Height="20"
                                    TickFrequency="256" ValueChanged="OnMaxTokensChanged" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

    </Grid>
</UserControl>
