<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Mofumofu.Launcher.Controls"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
             x:Class="Mofumofu.Launcher.Views.MofuAgentSettingsView"
             Background="Transparent">

    <UserControl.Styles>
        <Style Selector="TextBlock.setting-title">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource NekoTextBrush}" />
        </Style>
        <Style Selector="TextBlock.setting-hint">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource NekoDimBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.field-label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource NekoDimBrush}" />
        </Style>
        <Style Selector="TextBox.agent-field">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="9,5" />
        </Style>
        <Style Selector="ComboBox.agent-field">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="32" />
        </Style>

<!-- 供应商主从列表 -->        
        <Style Selector="Border.provider-row">
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Border.provider-row:pointerover">
            <Setter Property="Background" Value="{DynamicResource NekoFieldHoverBrush}" />
        </Style>
        <Style Selector="Border.provider-row.active">
            <Setter Property="Background" Value="{DynamicResource NekoAccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NekoAccentLineBrush}" />
        </Style>

<!-- 模型标签 -->        
        <Style Selector="Border.model-chip">
            <Setter Property="Background" Value="{DynamicResource NekoFieldBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NekoBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="7,2,2,2" />
            <Setter Property="Margin" Value="0,0,5,5" />
        </Style>

        <Style Selector="Border.field-soft">
            <Setter Property="Background" Value="{DynamicResource NekoFieldSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NekoBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="TextBlock.agent-mono">
            <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,Menlo,monospace" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource NekoMutedBrush}" />
        </Style>

        <Style Selector="Button.agent-mini">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Height" Value="22" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Background" Value="{DynamicResource NekoFieldBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource NekoMutedBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource NekoBorderBrush}" />
        </Style>
        <Style Selector="Button.agent-mini:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NekoControlHoverBrush}" />
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource NekoTextBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">
<!-- 页头 -->        
        <Grid ColumnDefinitions="Auto,*,Auto" Height="34" Margin="0,0,0,10">
            <Button Classes="round" Width="32" Height="32" VerticalAlignment="Center"
                    Click="OnBack" ToolTip.Tip="{DynamicResource L.Agent.Settings.T01}">
                <controls:IconParkIcon Kind="IconArrowLeft" Width="16" Height="16" />
            </Button>
            <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                       Text="{DynamicResource L.Agent.Settings.L01}" FontSize="11.5"
                       Foreground="{DynamicResource NekoMutedBrush}" />
            <Button Grid.Column="2" Classes="ghost" Height="30" Padding="12,0" VerticalAlignment="Center"
                    Click="OnBack">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <controls:IconParkIcon Kind="IconFluentChat" Width="14" Height="14" />
                    <TextBlock Text="{DynamicResource L.Agent.Settings.L02}" FontSize="11.5" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="164,*" ColumnSpacing="12">
<!-- 分区导航 -->            
            <Border Classes="card" CornerRadius="12" Padding="10">
                <StackPanel Spacing="2">
                    <TextBlock Classes="muted" Text="{DynamicResource L.Agent.Settings.L03}" Margin="6,2,0,8" />
                    <Button x:Name="TabProvider" Classes="pill active" Height="32" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left" Padding="10,0" Content="{DynamicResource L.Agent.Settings.B01}"
                            Click="OnSettingsTab" Tag="provider" />
                    <Button x:Name="TabGeneration" Classes="pill" Height="32" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left" Padding="10,0" Content="{DynamicResource L.Agent.Settings.B02}"
                            Click="OnSettingsTab" Tag="generation" />
                    <Button x:Name="TabContext" Classes="pill" Height="32" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left" Padding="10,0" Content="{DynamicResource L.Agent.Settings.B03}"
                            Click="OnSettingsTab" Tag="context" />
                    <Button x:Name="TabTools" Classes="pill" Height="32" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left" Padding="10,0" Content="{DynamicResource L.Agent.Settings.B04}"
                            Click="OnSettingsTab" Tag="tools" />
                    <Button x:Name="TabData" Classes="pill" Height="32" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left" Padding="10,0" Content="{DynamicResource L.Agent.Settings.B05}"
                            Click="OnSettingsTab" Tag="data" />
                    <Border Classes="divider" Margin="0,8" />
                    <TextBlock x:Name="SettingsPathText" Classes="caption" Margin="6,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

<!-- 内容 -->            
            <Border Grid.Column="1" Classes="card" CornerRadius="12" Padding="16,14">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Panel>
<!-- 供应商：预设工具栏 + 主从编辑台 -->                        
                        <StackPanel x:Name="PaneProvider" Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="setting-title" Text="{DynamicResource L.Agent.Settings.B01}" />
                                    <TextBlock Classes="setting-hint"
                                               Text="{DynamicResource L.Agent.Settings.L04}" />
                                </StackPanel>
                                
                            </Grid>

                            <Grid ColumnDefinitions="222,*" ColumnSpacing="12">
<!-- 主列表 -->                                
                                <Border Classes="card-soft" Padding="8" VerticalAlignment="Top">
                                    <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Classes="field-label" Text="{DynamicResource L.Agent.Settings.L05}" Margin="4,0,0,0"
                                                       VerticalAlignment="Center" />
                                            <TextBlock x:Name="ProviderCountText" Grid.Column="1"
                                                       Classes="agent-mono" Text="{DynamicResource L.Agent.Settings.L06}" />
                                        </Grid>

                                        <ScrollViewer Grid.Row="1" Height="300" VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel x:Name="ProviderListPanel" Spacing="2" />
                                        </ScrollViewer>

                                        <Button x:Name="AddProviderButton" Grid.Row="2" Classes="ghost" Height="32"
                                                HorizontalAlignment="Stretch" Click="OnAddProvider">
                                            <StackPanel Orientation="Horizontal" Spacing="6"
                                                        HorizontalAlignment="Center">
                                                <controls:IconParkIcon Kind="IconPlus" Width="12" Height="12" />
                                                <TextBlock Text="{DynamicResource L.Agent.Settings.L07}" FontSize="11.5" />
                                            </StackPanel>
                                        </Button>

                                        <TextBlock Grid.Row="3" Classes="caption" FontSize="10"
                                                   Text="{DynamicResource L.Agent.Settings.L08}" Margin="4,0,0,0" />
                                    </Grid>
                                </Border>

                                
                                <Panel Grid.Column="1" MinHeight="360">
                                    
                                    <Border x:Name="ProviderEmptyState" Classes="card-soft" Padding="20"
                                            IsVisible="False">
                                        <StackPanel Spacing="10" VerticalAlignment="Center"
                                                    HorizontalAlignment="Center" MaxWidth="300">
                                            <Border Width="42" Height="42" CornerRadius="13"
                                                    Background="{DynamicResource NekoAccentSoftBrush}"
                                                    HorizontalAlignment="Center">
                                                <controls:IconParkIcon Kind="IconPlus" Width="20" Height="20"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="{DynamicResource L.Agent.Settings.L09}" FontSize="14" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource NekoTextBrush}" />
                                            <TextBlock Classes="setting-hint" TextAlignment="Center"
                                                       Text="{DynamicResource L.Agent.Settings.L10}" />
                                            <Button Classes="primary" Height="32" Padding="14,0"
                                                    HorizontalAlignment="Center" Content="{DynamicResource L.Agent.Settings.L07}"
                                                    FontSize="11.5" Click="OnAddProvider" />
                                        </StackPanel>
                                    </Border>
<!-- 编辑台 -->
                                    
                                    <Border x:Name="ProviderCreateCard" Classes="card-soft" Padding="18"
                                            IsVisible="False">
                                        <StackPanel Spacing="10" MaxWidth="440" HorizontalAlignment="Left">
                                            <TextBlock Text="{DynamicResource L.Agent.Settings.L07}" Classes="setting-title" />
                                            <TextBlock Classes="setting-hint"
                                                       Text="{DynamicResource L.Agent.Settings.L11}" />

                                            <StackPanel Spacing="4">
                                                <TextBlock Classes="field-label"
                                                           Text="{DynamicResource L.Agent.Settings.L12}" />
                                                <ComboBox x:Name="PresetCombo" Classes="agent-field"
                                                          PlaceholderText="{DynamicResource L.Agent.Settings.P01}"
                                                          SelectionChanged="OnPresetChanged" />
                                                <TextBlock x:Name="PresetHint" Classes="caption" FontSize="10.5"
                                                           TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                                            </StackPanel>

                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Classes="field-label" Text="{DynamicResource L.Agent.Settings.L13}" />
                                                    <TextBox x:Name="NewNameBox" Classes="agent-field"
                                                             PlaceholderText="{DynamicResource L.Agent.Settings.P02}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="4">
                                                    <TextBlock Classes="field-label" Text="{DynamicResource L.Agent.Settings.L14}" />
                                                    <ComboBox x:Name="NewKindCombo" Classes="agent-field" />
                                                </StackPanel>
                                            </Grid>

                                            <StackPanel Spacing="4">
                                                <TextBlock Classes="field-label" Text="Base URL" />
                                                <TextBox x:Name="NewBaseUrlBox" Classes="agent-field"
                                                         PlaceholderText="{DynamicResource L.Agent.Settings.P03}" />
                                            </StackPanel>

                                            <StackPanel Spacing="4">
                                                <TextBlock Classes="field-label" Text="API Key" />
                                                <TextBox x:Name="NewApiKeyBox" Classes="agent-field"
                                                         PasswordChar="●" PlaceholderText="{DynamicResource L.Agent.Settings.P04}" />
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                                                <Button Classes="primary" Height="32" Padding="14,0"
                                                        Content="{DynamicResource L.Agent.Settings.B06}" FontSize="11.5"
                                                        Click="OnCreateProvider" />
                                                <Button Classes="ghost" Height="32" Padding="12,0"
                                                        Content="{DynamicResource L.Agent.Settings.B07}" FontSize="11.5" Click="OnCancelCreate" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    
                                    <StackPanel x:Name="ProviderEditor" Spacing="8" IsVisible="False">
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                        <StackPanel Spacing="4">
                                            <TextBlock Classes="field-label" Text="{DynamicResource L.Agent.Settings.L13}" />
                                            <TextBox x:Name="ProviderNameBox" Classes="agent-field"
                                                     PlaceholderText="{DynamicResource L.Agent.Settings.P05}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Classes="field-label" Text="{DynamicResource L.Agent.Settings.L14}" />
                                            <ComboBox x:Name="ProviderKindCombo" Classes="agent-field"
                                                      SelectionChanged="OnProviderKindChanged" />
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Spacing="4">
                                        <TextBlock Classes="field-label" Text="Base URL" />
                                        <TextBox x:Name="BaseUrlBox" Classes="agent-field"
                                                 PlaceholderText="{DynamicResource L.Agent.Settings.P03}" />
                                    </StackPanel>

                                    <StackPanel Spacing="4">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Classes="field-label" Text="API Key" />
                                            <Button Grid.Column="1" Classes="agent-mini" Height="20" Padding="6,0"
                                                    Content="{DynamicResource L.Agent.Settings.B08}" Click="OnToggleKeyVisibility" />
                                        </Grid>
                                        <TextBox x:Name="ApiKeyBox" Classes="agent-field" PasswordChar="●"
                                                 PlaceholderText="sk-..." />
                                        <TextBlock Classes="setting-hint"
                                                   Text="{DynamicResource L.Agent.Settings.L15}" />
                                    </StackPanel>

                                    <StackPanel Spacing="5">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Classes="field-label" Text="{DynamicResource L.Agent.Settings.L16}" />
                                            <TextBlock x:Name="ModelCountText" Grid.Column="1" Classes="agent-mono" />
                                        </Grid>
                                        <Border Classes="field-soft" CornerRadius="8" Padding="7,6,4,2"
                                                MinHeight="42">
                                            <ScrollViewer MaxHeight="96" VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled">
                                                <WrapPanel x:Name="ModelChipsPanel" />
                                            </ScrollViewer>
                                        </Border>
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                            <TextBox x:Name="NewModelBox" Classes="agent-field" Height="30"
                                                     PlaceholderText="{DynamicResource L.Agent.Settings.P06}" KeyDown="OnNewModelKeyDown" />
                                            <Button Grid.Column="1" Classes="ghost" Height="30" Padding="9,0"
                                                    Content="{DynamicResource L.Agent.Settings.B09}" FontSize="11" Click="OnAddModel" />
                                            <Button x:Name="FetchModelsButton" Grid.Column="2" Classes="ghost"
                                                    Height="30" Padding="9,0" FontSize="11" Click="OnFetchModels">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <controls:IconParkIcon Kind="IconRefresh" Width="11" Height="11" />
                                                    <TextBlock Text="{DynamicResource L.Agent.Settings.L17}" FontSize="11" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                        
                                    </StackPanel>

                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                        <StackPanel Spacing="4">
                                            <TextBlock Classes="field-label" Text="{DynamicResource L.Agent.Settings.L18}" />
                                            <TextBox x:Name="ProviderContextBox" Classes="agent-field"
                                                     PlaceholderText="0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Classes="field-label" Text="{DynamicResource L.Agent.Settings.L19}" />
                                            <ToggleSwitch x:Name="SupportsToolsSwitch" OnContent=""
                                                          OffContent="" />
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Spacing="4">
                                        <TextBlock Classes="field-label"
                                                   Text="{DynamicResource L.Agent.Settings.L20}" />
                                        <TextBox x:Name="HeadersBox" Classes="agent-field" AcceptsReturn="True"
                                                 MinHeight="48" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="6"
                                          Margin="0,4,0,0">
                                        <TextBlock x:Name="ProviderHintText" Classes="caption"
                                                   TextWrapping="Wrap" VerticalAlignment="Center" />
                                        <Button x:Name="SaveProviderButton" Grid.Column="1" Classes="ghost"
                                                Height="30" Padding="10,0" Content="{DynamicResource L.Agent.Settings.B10}" FontSize="11"
                                                Click="OnSaveProvider" />
                                        <Button x:Name="TestProviderButton" Grid.Column="2" Classes="primary"
                                                Height="30" Padding="10,0" Content="{DynamicResource L.Agent.Settings.B11}" FontSize="11"
                                                Click="OnTestProvider" />
                                        <Button Grid.Column="3" Classes="ghost" Height="30" Padding="10,0"
                                                Content="{DynamicResource L.Agent.Settings.B12}" FontSize="11" Click="OnSetActiveProvider" />
                                        <Button Grid.Column="4" Classes="ghost" Height="30" Padding="10,0"
                                                Content="{DynamicResource L.Agent.Settings.B13}" FontSize="11" Click="OnDeleteProvider" />
                                    </Grid>
                                    </StackPanel>
                                </Panel>
                            </Grid>

                            <TextBlock x:Name="ProviderResultText" Classes="caption" FontSize="11"
                                       TextWrapping="Wrap" MinHeight="16" Margin="2,0,0,0" />
                        </StackPanel>

<!-- 生成 -->                        
                        <StackPanel x:Name="PaneGeneration" Spacing="12" IsVisible="False">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="setting-title" Text="{DynamicResource L.Agent.Settings.B02}" />
                                <TextBlock Classes="setting-hint"
                                           Text="{DynamicResource L.Agent.Settings.L21}" />
                            </StackPanel>

                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Top P" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock x:Name="GenTopPText" Grid.Column="1" Classes="muted" Text="1.00" />
                            </Grid>
                            <Slider x:Name="GenTopPSlider" Minimum="0.1" Maximum="1" Value="1" Height="22"
                                    ValueChanged="OnGenTopPChanged" />

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="field-label" Text="{DynamicResource L.Agent.Settings.L23}" />
                                    <TextBox x:Name="GenMaxTokensBox" Classes="agent-field" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Classes="field-label" Text="{DynamicResource L.Agent.Settings.L24}" />
                                    <TextBox x:Name="GenMaxRoundsBox" Classes="agent-field" />
                                </StackPanel>
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="1">
                                    <TextBlock Text="{DynamicResource L.Agent.Settings.L25}" FontSize="12" />
                                    <TextBlock Classes="caption" Text="{DynamicResource L.Agent.Settings.L26}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="StreamingSwitch" Grid.Column="1" OnContent="" OffContent="" />
                            </Grid>

                            <StackPanel Spacing="4">
                                <TextBlock Classes="field-label" Text="{DynamicResource L.Agent.Settings.L27}" />
                                <TextBox x:Name="SystemPromptBox" Classes="agent-field" AcceptsReturn="True"
                                         TextWrapping="Wrap" MinHeight="220"
                                         FontFamily="Cascadia Mono,Consolas,monospace" FontSize="11.5" />
                                <TextBlock Classes="setting-hint"
                                           Text="{DynamicResource L.Agent.Settings.L28}" />
                            </StackPanel>

                            <Button Classes="primary" Height="30" Padding="12,0" Content="{DynamicResource L.Agent.Settings.B14}"
                                    FontSize="11.5" HorizontalAlignment="Left" Click="OnSaveGeneration" />
                        </StackPanel>

<!-- 上下文 -->                        
                        <StackPanel x:Name="PaneContext" Spacing="12" IsVisible="False">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="setting-title" Text="{DynamicResource L.Agent.Settings.B03}" />
                                <TextBlock Classes="setting-hint"
                                           Text="{DynamicResource L.Agent.Settings.L29}" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Classes="field-label" Text="{DynamicResource L.Agent.Settings.L30}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ComboBox x:Name="WindowPresetCombo" Classes="agent-field" Width="180"
                                              SelectionChanged="OnWindowPresetChanged" />
                                    <TextBox x:Name="WindowCustomBox" Classes="agent-field" Width="150" />
                                    <Button Classes="ghost" Height="32" Padding="10,0" Content="{DynamicResource L.Agent.Settings.B15}"
                                            FontSize="11.5" Click="OnApplyWindow" />
                                </StackPanel>
                            </StackPanel>

                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="1">
                                    <TextBlock Text="{DynamicResource L.Agent.Settings.L31}" FontSize="12" />
                                    <TextBlock Classes="caption" Text="{DynamicResource L.Agent.Settings.L32}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="AutoCompactSwitch" Grid.Column="1" OnContent="" OffContent="" />
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{DynamicResource L.Agent.Settings.L33}" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock x:Name="CompactAtText" Grid.Column="1" Classes="muted" Text="78%" />
                            </Grid>
                            <Slider x:Name="CompactAtSlider" Minimum="0.4" Maximum="0.95" Value="0.78" Height="22"
                                    ValueChanged="OnCompactAtChanged" />

                            <StackPanel Spacing="4">
                                <TextBlock Classes="field-label" Text="{DynamicResource L.Agent.Settings.L34}" />
                                <TextBox x:Name="KeepRecentBox" Classes="agent-field" Width="160"
                                         HorizontalAlignment="Left" />
                            </StackPanel>

                            <Button Classes="primary" Height="30" Padding="12,0" Content="{DynamicResource L.Agent.Settings.B16}"
                                    FontSize="11.5" HorizontalAlignment="Left" Click="OnSaveContext" />
                        </StackPanel>

<!-- 工具 -->                        
                        <StackPanel x:Name="PaneTools" Spacing="12" IsVisible="False">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="setting-title" Text="{DynamicResource L.Agent.Settings.B04}" />
                                <TextBlock Classes="setting-hint"
                                           Text="{DynamicResource L.Agent.Settings.L35}" />
                            </StackPanel>

                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="1">
                                    <TextBlock Text="{DynamicResource L.Agent.Settings.L36}" FontSize="12" />
                                    <TextBlock Classes="caption" Text="{DynamicResource L.Agent.Settings.L37}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="ToolsEnabledSwitch" Grid.Column="1" OnContent="" OffContent="" />
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="1">
                                    <TextBlock Text="{DynamicResource L.Agent.Settings.L38}" FontSize="12" />
                                    <TextBlock Classes="caption" Text="{DynamicResource L.Agent.Settings.L39}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="LauncherToolsSwitch" Grid.Column="1" OnContent="" OffContent="" />
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="1">
                                    <TextBlock Text="{DynamicResource L.Agent.Settings.L40}" FontSize="12" />
                                    <TextBlock Classes="caption" Text="{DynamicResource L.Agent.Settings.L41}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="ConfirmWritesSwitch" Grid.Column="1" OnContent="" OffContent="" />
                            </Grid>

                            <StackPanel Spacing="4">
                                <TextBlock Classes="field-label" Text="{DynamicResource L.Agent.Settings.L42}" />
                                <TextBox x:Name="ToolTimeoutBox" Classes="agent-field" Width="160"
                                         HorizontalAlignment="Left" />
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Classes="field-label" Text="{DynamicResource L.Agent.Settings.L43}" />
                                <StackPanel x:Name="ToolListPanel" Spacing="4" />
                            </StackPanel>

                            <Button Classes="primary" Height="30" Padding="12,0" Content="{DynamicResource L.Agent.Settings.B17}"
                                    FontSize="11.5" HorizontalAlignment="Left" Click="OnSaveTools" />
                        </StackPanel>

<!-- 数据 -->                        
                        <StackPanel x:Name="PaneData" Spacing="12" IsVisible="False">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="setting-title" Text="{DynamicResource L.Agent.Settings.B05}" />
                                <TextBlock Classes="setting-hint"
                                           Text="{DynamicResource L.Agent.Settings.L44}" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Classes="field-label" Text="{DynamicResource L.Agent.Settings.L45}" />
                                <TextBox x:Name="DataPathBox" Classes="agent-field" IsReadOnly="True" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Classes="ghost" Height="30" Padding="12,0" Content="{DynamicResource L.Agent.Settings.B18}"
                                        FontSize="11.5" Click="OnOpenDataFolder" />
                                <Button Classes="ghost" Height="30" Padding="12,0" Content="{DynamicResource L.Agent.Settings.B19}"
                                        FontSize="11.5" Click="OnClearAllSessions" />
                            </StackPanel>

                            <Border Classes="divider" />

                            <StackPanel Spacing="4">
                                <TextBlock Classes="field-label" Text="{DynamicResource L.Agent.Settings.L46}" />
                                <TextBlock x:Name="KeyPathText" Classes="caption" TextWrapping="Wrap" />
                                <TextBlock Classes="setting-hint"
                                           Text="{DynamicResource L.Agent.Settings.L47}" />
                                <Button x:Name="ResetKeyButton" Classes="ghost" Height="28" Padding="10,0"
                                        Content="{DynamicResource L.Agent.Settings.B20}" FontSize="11" HorizontalAlignment="Left"
                                        Click="OnResetKey" />
                            </StackPanel>

                            <Border Classes="divider" />

                            <StackPanel Spacing="4">
                                <TextBlock Classes="field-label" Text="{DynamicResource L.Agent.Settings.L48}" />
                                <ScrollViewer Height="170" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="MemoryPanel" Spacing="4" />
                                </ScrollViewer>
                                <Button Classes="ghost" Height="28" Padding="10,0" Content="{DynamicResource L.Agent.Settings.B21}"
                                        FontSize="11.5" HorizontalAlignment="Left" Click="OnClearMemory" />
                            </StackPanel>
                        </StackPanel>
                    </Panel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
