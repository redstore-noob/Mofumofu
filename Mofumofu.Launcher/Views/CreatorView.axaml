<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Mofumofu.Launcher.Controls"
             xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
             mc:Ignorable="d" d:DesignWidth="1240" d:DesignHeight="720"
             x:Class="Mofumofu.Launcher.Views.CreatorView">
    <Grid RowDefinitions="Auto,*">
        <controls:PageHeader Grid.Row="0">
            <controls:PageHeader.Actions>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Classes="icon" Width="34" Height="34" Click="OnOpenWorkspaceClick"
                            ToolTip.Tip="{DynamicResource L.Creator.List.OpenWorkspace}">
                        <controls:IconParkIcon Kind="IconFolder" Width="15" Height="15" />
                    </Button>
                    <Button Classes="icon" Width="34" Height="34" Click="OnOpenInstancesClick"
                            ToolTip.Tip="{DynamicResource L.Creator.List.Action.Instances}">
                        <controls:IconParkIcon Kind="IconFluentCube" Width="15" Height="15" />
                    </Button>
                    <Button Classes="icon" Width="34" Height="34" Click="OnOpenPluginsClick"
                            ToolTip.Tip="{DynamicResource L.Creator.List.Action.Plugins}">
                        <controls:IconParkIcon Kind="IconFluentPuzzle" Width="15" Height="15" />
                    </Button>
                    <Button Classes="icon" Width="34" Height="34" Click="OnExportLogClick"
                            ToolTip.Tip="{DynamicResource L.Creator.Log.Export}">
                        <controls:IconParkIcon Kind="IconFluentDocument" Width="15" Height="15" />
                    </Button>
                </StackPanel>
            </controls:PageHeader.Actions>
        </controls:PageHeader>

        <Grid Grid.Row="1" ColumnDefinitions="236,*" Margin="0,2,0,0">
            <suki:GlassCard Grid.Column="0" CornerRadius="18" Padding="12,14"
                            Margin="0,0,16,0" VerticalAlignment="Stretch">
                <StackPanel x:Name="ToolNavPanel" Spacing="4" />
            </suki:GlassCard>

            <Grid Grid.Column="1">
                    <ContentControl x:Name="ToolBody" />

                    <Grid x:Name="CubeTextPanel" IsVisible="False"
                          ColumnDefinitions="330,*">
                        <ScrollViewer Grid.Column="0"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto"
                                      Padding="0,0,10,0">
                            <StackPanel Margin="0,0,0,14">

                                <Border Classes="setting-group">
                                    <StackPanel>
                                        <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,8">
                                            <Border Width="30" Height="30" CornerRadius="9"
                                                    Background="{DynamicResource NekoAccentSoftBrush}">
                                                <controls:IconParkIcon Kind="IconFluentFont" Width="15" Height="15"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Margin="10,0,0,0"
                                                       Text="{DynamicResource L.Creator.Cube.Group.Text}" Classes="group-title"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                        <StackPanel Spacing="5" Margin="0,4,0,6">
                                            <TextBlock Text="{DynamicResource L.Creator.Cube.Text}" Classes="row-label" />
                                            <TextBox x:Name="CubeTextInput" Text="Mofumofu" Height="84"
                                                     AcceptsReturn="True" TextWrapping="Wrap"
                                                     VerticalContentAlignment="Top" FontSize="13" />
                                        </StackPanel>
                                        <Border Classes="setting-row">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{DynamicResource L.Creator.Cube.Font}" Classes="row-label" />
                                                <ComboBox x:Name="CubeFontCombo" Grid.Column="1" Width="170" />
                                            </Grid>
                                        </Border>
                                        <Border Classes="setting-row">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{DynamicResource L.Creator.Cube.Bold}" Classes="row-label" />
                                                <ToggleSwitch x:Name="CubeBoldCheck" Grid.Column="1" IsChecked="True"
                                                              OnContent="{DynamicResource L.Common.Enabled}"
                                                              OffContent="{DynamicResource L.Common.Disabled}" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Classes="setting-group">
                                    <StackPanel>
                                        <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,8">
                                            <Border Width="30" Height="30" CornerRadius="9"
                                                    Background="{DynamicResource NekoAccentSoftBrush}">
                                                <controls:IconParkIcon Kind="IconFluentCube" Width="15" Height="15"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Margin="10,0,0,0"
                                                       Text="{DynamicResource L.Creator.Cube.Group.Geometry}" Classes="group-title"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                        <Border Classes="setting-row">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{DynamicResource L.Creator.Cube.FontSize}" Classes="row-label" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                    <TextBlock x:Name="CubeFontSizeValue" Classes="value-text" Text="128" />
                                                    <Slider x:Name="CubeFontSizeSlider" Width="120" Minimum="48" Maximum="256"
                                                            TickFrequency="8" IsSnapToTickEnabled="True" Value="128" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Border Classes="setting-row">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{DynamicResource L.Creator.Cube.Resolution}" Classes="row-label" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                    <TextBlock x:Name="CubeResolutionValue" Classes="value-text" Text="5" />
                                                    <Slider x:Name="CubeResolutionSlider" Width="120" Minimum="2" Maximum="10"
                                                            TickFrequency="1" IsSnapToTickEnabled="True" Value="5" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Border Classes="setting-row">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{DynamicResource L.Creator.Cube.Depth}" Classes="row-label" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                    <TextBlock x:Name="CubeDepthValue" Classes="value-text" Text="1.0" />
                                                    <Slider x:Name="CubeDepthSlider" Width="120" Minimum="0.2" Maximum="3"
                                                            TickFrequency="0.1" IsSnapToTickEnabled="True" Value="1" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Border Classes="setting-row">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{DynamicResource L.Creator.Cube.Spacing}" Classes="row-label" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                    <TextBlock x:Name="CubeSpacingValue" Classes="value-text" Text="0.06" />
                                                    <Slider x:Name="CubeSpacingSlider" Width="120" Minimum="0" Maximum="0.4"
                                                            TickFrequency="0.02" IsSnapToTickEnabled="True" Value="0.06" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Classes="setting-group">
                                    <StackPanel>
                                        <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,8">
                                            <Border Width="30" Height="30" CornerRadius="9"
                                                    Background="{DynamicResource NekoAccentSoftBrush}">
                                                <controls:IconParkIcon Kind="IconFluentPaint" Width="15" Height="15"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Margin="10,0,0,0"
                                                       Text="{DynamicResource L.Creator.Cube.Group.Color}" Classes="group-title"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                        <Border Classes="setting-row">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{DynamicResource L.Creator.Cube.ColorMode}" Classes="row-label" />
                                                <ComboBox x:Name="CubeColorModeCombo" Grid.Column="1" Width="150" />
                                            </Grid>
                                        </Border>
                                        <Border Classes="setting-row">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{DynamicResource L.Creator.Cube.ColorA}" Classes="row-label" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                    <TextBox x:Name="CubeColorAText" Text="#38BDF8" Width="100"
                                                             FontSize="12" Height="30" />
                                                    <Border x:Name="CubeColorASwatch" Width="26" Height="26"
                                                            CornerRadius="7" BorderThickness="1"
                                                            BorderBrush="{DynamicResource NekoBorderBrush}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Border Classes="setting-row">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{DynamicResource L.Creator.Cube.ColorB}" Classes="row-label" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                    <TextBox x:Name="CubeColorBText" Text="#A855F7" Width="100"
                                                             FontSize="12" Height="30" />
                                                    <Border x:Name="CubeColorBSwatch" Width="26" Height="26"
                                                            CornerRadius="7" BorderThickness="1"
                                                            BorderBrush="{DynamicResource NekoBorderBrush}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Border Classes="setting-row">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{DynamicResource L.Creator.Cube.Texture}" Classes="row-label" />
                                                <ComboBox x:Name="CubeTextureCombo" Grid.Column="1" Width="150" />
                                            </Grid>
                                        </Border>
                                        <Border Classes="setting-row">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{DynamicResource L.Creator.Cube.Outline}" Classes="row-label" />
                                                <ToggleSwitch x:Name="CubeOutlineCheck" Grid.Column="1" IsChecked="True"
                                                              OnContent="{DynamicResource L.Common.Enabled}"
                                                              OffContent="{DynamicResource L.Common.Disabled}" />
                                            </Grid>
                                        </Border>
                                        <Border Classes="setting-row">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{DynamicResource L.Creator.Cube.OutlineColor}" Classes="row-label" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                    <TextBox x:Name="CubeOutlineColorText" Text="#0F172A" Width="100"
                                                             FontSize="12" Height="30" />
                                                    <Border x:Name="CubeOutlineSwatch" Width="26" Height="26"
                                                            CornerRadius="7" BorderThickness="1"
                                                            BorderBrush="{DynamicResource NekoBorderBrush}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Classes="setting-group">
                                    <StackPanel>
                                        <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,8">
                                            <Border Width="30" Height="30" CornerRadius="9"
                                                    Background="{DynamicResource NekoAccentSoftBrush}">
                                                <controls:IconParkIcon Kind="IconFluentDesktop" Width="15" Height="15"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Margin="10,0,0,0"
                                                       Text="{DynamicResource L.Creator.Cube.Group.Preview}" Classes="group-title"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                        <Border Classes="setting-row">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{DynamicResource L.Creator.Cube.AutoRotate}" Classes="row-label" />
                                                <ToggleSwitch x:Name="CubeAutoRotateCheck" Grid.Column="1"
                                                              OnContent="{DynamicResource L.Common.Enabled}"
                                                              OffContent="{DynamicResource L.Common.Disabled}" />
                                            </Grid>
                                        </Border>
                                        <Border Classes="setting-row">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{DynamicResource L.Creator.Cube.Transparent}" Classes="row-label" />
                                                <ToggleSwitch x:Name="CubeTransparentCheck" Grid.Column="1"
                                                              OnContent="{DynamicResource L.Common.Enabled}"
                                                              OffContent="{DynamicResource L.Common.Disabled}" />
                                            </Grid>
                                        </Border>
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,8,0,0">
                                            <Button Classes="ghost" Height="32" Content="{DynamicResource L.Creator.Cube.ResetCamera}"
                                                    Click="OnCubeResetClick" HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Center" />
                                            <Button Grid.Column="1" Classes="primary" Height="32" Content="{DynamicResource L.Creator.Cube.ExportPng}"
                                                    Click="OnCubeExportClick" HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Center" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

<!-- WebView2 锚点：必须放在 ScrollViewer 之外，滚动时才能正确裁剪 -->
                        <Border x:Name="CubeTextHost" Grid.Column="1" Margin="12,0,0,0"
                                CornerRadius="12"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource NekoBorderBrush}"
                                Background="{DynamicResource NekoFieldSoftBrush}"
                                ClipToBounds="True">
                            <Grid>
                                <TextBlock Text="{DynamicResource L.Creator.Cube.PreviewPlaceholder}"
                                           Classes="caption"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
</UserControl>
