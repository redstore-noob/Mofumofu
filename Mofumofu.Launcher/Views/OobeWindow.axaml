<suki:SukiWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
                 xmlns:controls="clr-namespace:Mofumofu.Launcher.Controls"
                 x:Class="Mofumofu.Launcher.Views.OobeWindow"
                 Title="Mofumofu Launcher"
                 Width="880" Height="640"
                 MinWidth="760" MinHeight="560"
                 CanResize="False"
                 WindowStartupLocation="CenterScreen">
    <Grid RowDefinitions="Auto,*,Auto">
        <!-- 顶部：Logo / 标题 / 步骤 -->
        <Border Grid.Row="0" Padding="26,20,26,14">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Image Width="46" Height="46" VerticalAlignment="Center"
                       Source="avares://Mofumofu.Launcher/Assets/mascot-neko.png" />
                <StackPanel Grid.Column="1" Margin="14,0,0,0" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource L.Oobe.Title}" FontSize="20" FontWeight="Bold" />
                    <TextBlock Text="{DynamicResource L.Oobe.Subtitle}" Classes="caption" />
                </StackPanel>
                <Button Grid.Column="2" Classes="ghost" Height="30" Padding="10,0"
                        Content="{DynamicResource L.Oobe.Skip}" Click="OnSkipClick" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <Grid Margin="28,6,28,0">
                <!-- 1. 欢迎 -->
                <StackPanel x:Name="WelcomePanel" Spacing="16">
                    <TextBlock Text="{DynamicResource L.Oobe.WelcomeTitle}" Classes="section-title" />
                    <TextBlock Text="{DynamicResource L.Oobe.WelcomeBody}" Classes="caption"
                               TextWrapping="Wrap" />
                    <Border Classes="card-soft" Padding="18,16">
                        <StackPanel Spacing="14">
                            <Grid ColumnDefinitions="220,*">
                                <TextBlock Text="{DynamicResource L.Oobe.Language}" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" x:Name="LanguageCombo" HorizontalAlignment="Stretch"
                                          SelectionChanged="OnLanguageChanged" />
                            </Grid>
                            <Grid ColumnDefinitions="220,*">
                                <TextBlock Text="{DynamicResource L.Oobe.Theme}" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" x:Name="ThemeCombo" HorizontalAlignment="Stretch"
                                          SelectionChanged="OnThemeChanged">
                                    <ComboBoxItem Content="{DynamicResource L.Oobe.Theme.System}" Tag="system" />
                                    <ComboBoxItem Content="{DynamicResource L.Oobe.Theme.Dark}" Tag="dark" />
                                    <ComboBoxItem Content="{DynamicResource L.Oobe.Theme.Light}" Tag="light" />
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 2. 游戏目录 -->
                <StackPanel x:Name="DirectoryPanel" Spacing="16" IsVisible="False">
                    <TextBlock Text="{DynamicResource L.Oobe.DirectoryTitle}" Classes="section-title" />
                    <TextBlock Text="{DynamicResource L.Oobe.DirectoryBody}" Classes="caption"
                               TextWrapping="Wrap" />
                    <Border Classes="card-soft" Padding="18,16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{DynamicResource L.Oobe.DirectoryLabel}" Classes="caption" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox x:Name="GameDirectoryBox" Height="34" />
                                <Button Grid.Column="1" Classes="ghost" Height="34" Padding="12,0"
                                        Content="{DynamicResource L.Oobe.Browse}" Click="OnBrowseDirectoryClick" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 3. Java -->
                <StackPanel x:Name="JavaPanel" Spacing="16" IsVisible="False">
                    <TextBlock Text="{DynamicResource L.Oobe.JavaTitle}" Classes="section-title" />
                    <TextBlock Text="{DynamicResource L.Oobe.JavaBody}" Classes="caption"
                               TextWrapping="Wrap" />
                    <Border Classes="card-soft" Padding="18,16">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="220,*">
                                <TextBlock Text="{DynamicResource L.Oobe.JavaLabel}" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" x:Name="JavaCombo" HorizontalAlignment="Stretch" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Classes="ghost" Height="30" Padding="10,0"
                                        Content="{DynamicResource L.Oobe.JavaDetect}" Click="OnDetectJavaClick" />
                                <TextBlock x:Name="JavaStatusText" Classes="caption"
                                           VerticalAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Text="{DynamicResource L.Oobe.JavaLater}" Classes="caption"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 4. 账号 -->
                <StackPanel x:Name="AccountPanel" Spacing="16" IsVisible="False">
                    <TextBlock Text="{DynamicResource L.Oobe.AccountTitle}" Classes="section-title" />
                    <TextBlock Text="{DynamicResource L.Oobe.AccountBody}" Classes="caption"
                               TextWrapping="Wrap" />
                    <Border Classes="card-soft" Padding="18,16">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="160,*">
                                <TextBlock Text="{DynamicResource L.Oobe.AccountType}" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" x:Name="AccountTypeCombo" HorizontalAlignment="Stretch"
                                          SelectedIndex="0" SelectionChanged="OnAccountTypeChanged">
                                    <ComboBoxItem Content="{DynamicResource L.Oobe.Account.Type.Offline}" Tag="offline" />
                                    <ComboBoxItem Content="{DynamicResource L.Oobe.Account.Type.Microsoft}" Tag="microsoft" />
                                    <ComboBoxItem Content="{DynamicResource L.Oobe.Account.Type.Authlib}" Tag="authlib" />
                                </ComboBox>
                            </Grid>

                            <!-- 离线 -->
                            <StackPanel x:Name="OfflineAccountPanel" Spacing="8">
                                <TextBlock Text="{DynamicResource L.Oobe.AccountLabel}" Classes="caption" />
                                <TextBox x:Name="OfflineNameBox" Height="34" MaxLength="16"
                                         PlaceholderText="{DynamicResource L.Oobe.AccountPlaceholder}" />
                                <TextBlock Text="{DynamicResource L.Oobe.AccountHint}" Classes="caption"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- Microsoft -->
                            <StackPanel x:Name="MicrosoftAccountPanel" Spacing="8" IsVisible="False">
                                <TextBlock Text="{DynamicResource L.Oobe.Account.MicrosoftHint}" Classes="caption"
                                           TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button x:Name="MicrosoftLoginButton" Classes="primary" Height="34" Padding="14,0"
                                            Content="{DynamicResource L.Oobe.Account.MicrosoftLogin}"
                                            Click="OnMicrosoftLoginClick" />
                                    <TextBlock x:Name="MicrosoftStatusText" Classes="caption"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>

                            <!-- 外置登录 -->
                            <StackPanel x:Name="AuthlibAccountPanel" Spacing="8" IsVisible="False">
                                <TextBlock Text="{DynamicResource L.Oobe.Account.AuthlibHint}" Classes="caption"
                                           TextWrapping="Wrap" />
                                <TextBox x:Name="AuthlibServerBox" Height="34"
                                         PlaceholderText="{DynamicResource L.Oobe.Account.AuthlibServer}" />
                                <TextBox x:Name="AuthlibUsernameBox" Height="34"
                                         PlaceholderText="{DynamicResource L.Oobe.Account.AuthlibUsername}" />
                                <TextBox x:Name="AuthlibPasswordBox" Height="34" PasswordChar="●"
                                         PlaceholderText="{DynamicResource L.Oobe.Account.AuthlibPassword}" />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button x:Name="AuthlibLoginButton" Classes="primary" Height="34" Padding="14,0"
                                            Content="{DynamicResource L.Oobe.Account.AuthlibLogin}"
                                            Click="OnAuthlibLoginClick" />
                                    <TextBlock x:Name="AuthlibStatusText" Classes="caption"
                                               VerticalAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 5. 完成 -->
                <StackPanel x:Name="FinishPanel" Spacing="16" IsVisible="False">
                    <TextBlock Text="{DynamicResource L.Oobe.FinishTitle}" Classes="section-title" />
                    <TextBlock Text="{DynamicResource L.Oobe.FinishBody}" Classes="caption"
                               TextWrapping="Wrap" />
                    <Border Classes="card-soft" Padding="18,16">
                        <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                            <TextBlock Text="{DynamicResource L.Oobe.SummaryLanguage}" Classes="caption" />
                            <TextBlock Grid.Column="1" x:Name="SummaryLanguage" />
                            <TextBlock Grid.Row="1" Text="{DynamicResource L.Oobe.SummaryDirectory}" Classes="caption" />
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="SummaryDirectory"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Row="2" Text="{DynamicResource L.Oobe.SummaryJava}" Classes="caption" />
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="SummaryJava"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Row="3" Text="{DynamicResource L.Oobe.SummaryAccount}" Classes="caption" />
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="SummaryAccount" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- 底部导航 -->
        <Border Grid.Row="2" Padding="26,14,26,20"
                BorderThickness="0,1,0,0" BorderBrush="{DynamicResource NekoBorderBrush}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="StepText" Classes="caption" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="BackButton" Classes="ghost" Height="36" Padding="16,0"
                            Content="{DynamicResource L.Oobe.Back}" Click="OnBackClick"
                            IsVisible="False" />
                    <Button x:Name="NextButton" Classes="primary" Height="36" Padding="18,0"
                            Content="{DynamicResource L.Oobe.Next}" Click="OnNextClick" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</suki:SukiWindow>
